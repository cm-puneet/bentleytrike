{%- comment -%}
  BT Homepage — The craft (dark spotlight)
  The selected finish sits in a soft spotlight with the Bentley details around it.
  Its finishes come straight from the Trike buy box on the same page, so there is
  nothing to set up here; the colour circles stay in sync with the buy box.
  A faint smoke trail follows the mouse.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign uid = section.id | replace: '_', '' | replace: '-', '' | downcase
  assign notes = section.blocks | where: 'type', 'note'
  assign specs = section.blocks | where: 'type', 'spec'
  assign vers = section.blocks | where: 'type', 'version'
-%}

<style>
  .bthp-crf{--bthp-hs:var(--bthp-hs-d,1)}
  @media (max-width:749px){.bthp-crf{--bthp-hs:var(--bthp-hs-m,1)}}
  .bthp-crf{content-visibility:auto;contain-intrinsic-size:auto 1100px;position:relative;overflow:hidden;background:var(--bthp-bg);color:var(--bthp-ink);font-family:var(--text-font-family,Poppins,sans-serif);padding:clamp(96px,10vw,152px) 0 clamp(72px,8vw,120px)}
  .bthp-crf__glow{position:absolute;left:50%;top:46%;width:min(980px,90vw);aspect-ratio:1/1;transform:translate(-50%,-50%);background:radial-gradient(closest-side,rgba(248,244,239,.24),rgba(248,244,239,.07) 55%,rgba(248,244,239,0));pointer-events:none}
  .bthp-smoke{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:.2}
  .bthp-crf__wrap{position:relative;max-width:1440px;margin:0 auto;padding:0 clamp(20px,4.4vw,64px);box-sizing:border-box}
  .bthp-crf__head{text-align:center;display:flex;flex-direction:column;align-items:center;gap:18px;margin-bottom:24px}
  .bthp-crf__label{margin:0;font-size:10px;font-weight:700;letter-spacing:.28em;text-transform:uppercase;color:var(--bthp-sand)}
  .bthp-crf__h{margin:0;font-family:var(--heading-font-family,"Playfair Display",serif);font-weight:400;font-size:calc(clamp(40px,5.2vw,84px) * var(--bthp-hs, 1));line-height:.98;letter-spacing:-.01em;color:var(--bthp-ink)}
  .bthp-crf__h em{display:block;font-style:italic;color:var(--bthp-sand)}
  .bthp-crf__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr) minmax(0,1fr);align-items:center;gap:24px}
  .bthp-crf__col{display:flex;flex-direction:column;gap:64px}
  .bthp-crf__col--r{text-align:right;align-items:flex-end}
  .bthp-crf__note{display:flex;flex-direction:column;gap:12px;max-width:290px;transition:opacity .5s ease}
  button.bthp-crf__note{margin:0;padding:0;border:0;background:none;font:inherit;color:inherit;text-align:inherit;cursor:pointer;align-items:inherit}
  .bthp-crf__col--r button.bthp-crf__note{align-items:flex-end}
  .bthp-crf__note h3{transition:color .4s ease}
  button.bthp-crf__note:hover h3,.bthp-crf__note.is-on h3{color:var(--bthp-sand)}
  .bthp-crf__n::after{transition:width .5s cubic-bezier(.2,.7,.2,1)}
  button.bthp-crf__note:hover .bthp-crf__n::after,.bthp-crf__note.is-on .bthp-crf__n::after{width:88px}
  .bthp-crf.has-detail .bthp-crf__note:not(.is-on){opacity:.42}
  .bthp-crf__more{font-size:10px;font-weight:700;letter-spacing:.24em;text-transform:uppercase;color:var(--bthp-sand);text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px}
  .bthp-crf__note.is-on .bthp-crf__more{text-decoration:none;opacity:.6}
  button.bthp-crf__note:focus-visible{outline:1px solid var(--bthp-sand);outline-offset:8px}
  .bthp-crf__n{display:flex;align-items:center;gap:14px;font-size:10px;font-weight:700;letter-spacing:.28em;color:var(--bthp-sand)}
  .bthp-crf__col--r .bthp-crf__n{flex-direction:row-reverse}
  .bthp-crf__n::after{content:"";display:block;width:56px;height:1px;background:currentColor;opacity:.6}
  .bthp-crf__note h3{margin:0;font-family:var(--heading-font-family,"Playfair Display",serif);font-weight:400;font-size:26px;line-height:1.15;color:var(--bthp-ink)}
  .bthp-crf__note p{margin:0;font-size:14px;line-height:1.7;opacity:.8}
  .bthp-crf__stage{position:relative;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center}
  .bthp-crf__stage .bthp-prod{position:relative;width:92%;aspect-ratio:1/1;transition:opacity .5s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
  .bthp-crf.has-detail .bthp-crf__stage .bthp-prod{opacity:0;transform:scale(.94)}
  .bthp-crf__dm{position:absolute;inset:5%;pointer-events:none}
  .bthp-crf__dimg{position:absolute;inset:0;margin:0;display:none;overflow:hidden;background:#2a2622;opacity:0;transform:scale(1.04);transition:opacity .6s ease,transform .9s cubic-bezier(.2,.7,.2,1);box-shadow:0 40px 80px rgba(0,0,0,.45)}
  .bthp-crf__dimg.is-shown{display:block}
  .bthp-crf__dimg.is-on{opacity:1;transform:none}
  .bthp-crf__dimg img{display:block;width:100%;height:100%;object-fit:cover}
  .bthp-crf__dimg figcaption{position:absolute;left:0;right:0;bottom:0;display:flex;align-items:baseline;gap:12px;padding:40px 20px 18px;background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,.62) 100%);font-family:var(--heading-font-family,"Playfair Display",serif);font-size:22px;color:#ffffff;text-align:left}
  .bthp-crf__dimg figcaption span{font-family:var(--text-font-family,Poppins,sans-serif);font-size:10px;font-weight:700;letter-spacing:.24em;color:var(--bthp-sand)}
  .bthp-crf__back{position:absolute;top:12px;right:12px;z-index:2;display:inline-flex;align-items:center;gap:10px;min-height:40px;padding:0 14px;border:1px solid rgba(248,244,239,.35);border-radius:0;background:rgba(26,26,26,.72);color:var(--bthp-ink);cursor:pointer;pointer-events:auto;font-family:var(--text-font-family,Poppins,sans-serif);font-size:10px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;transition:background .3s ease}
  .bthp-crf__back:hover{background:rgba(26,26,26,.92)}
  .bthp-crf__back[hidden]{display:none}
  .bthp-crf__stage .bthp-prod .bthp-f-ph{width:100%;height:100%;opacity:.25;fill:currentColor}
  .bthp-crf__stage .bthp-prod::before{content:"";position:absolute;left:16%;right:16%;bottom:3%;height:14%;border-radius:50%;background:radial-gradient(closest-side,rgba(0,0,0,.55),rgba(0,0,0,.18) 60%,rgba(0,0,0,0));pointer-events:none}
  .bthp-crf__stage .bthp-prod img{position:relative}
  .bthp-prod img{display:block;width:100%;height:100%;object-fit:contain}
  .bthp-prod.is-in{animation:bthpProdIn .9s cubic-bezier(.2,.7,.2,1)}
  @keyframes bthpProdIn{from{opacity:0;transform:translate3d(28px,0,0) scale(.97)}to{opacity:1;transform:none}}
  .bthp-crf .bthp-sheen{position:absolute;inset:0;pointer-events:none;overflow:hidden;-webkit-mask-image:var(--m);mask-image:var(--m);-webkit-mask-size:contain;mask-size:contain;-webkit-mask-position:center;mask-position:center;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat}
  .bthp-crf .bthp-sheen:not([style*="--m"]){display:none}
  .bthp-crf .bthp-sheen::before{content:"";position:absolute;top:0;bottom:0;left:0;width:40%;background:linear-gradient(105deg,rgba(255,255,255,0),rgba(255,255,255,.5) 50%,rgba(255,255,255,0));transform:translate3d(-110%,0,0)}
  .bthp-crf .bthp-sheen.is-go::before{animation:bthpCrfSheen 1.9s cubic-bezier(.45,0,.25,1) forwards}
  @keyframes bthpCrfSheen{from{transform:translate3d(-110%,0,0)}to{transform:translate3d(260%,0,0)}}
  .bthp-crf__pick{position:relative;display:flex;flex-direction:column;align-items:center;gap:12px;margin-top:8px}
  .bthp-crf__row{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
  .bthp-crf .bthp-sw{width:44px;height:44px;border-radius:50%;border:0;padding:0;background:transparent;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;box-shadow:inset 0 0 0 1px rgba(248,244,239,.24);transition:box-shadow .3s ease}
  .bthp-crf .bthp-sw:hover{box-shadow:inset 0 0 0 1px rgba(248,244,239,.6)}
  .bthp-crf .bthp-sw[aria-checked="true"]{box-shadow:inset 0 0 0 1.5px var(--bthp-ink)}
  .bthp-crf .bthp-sw i{display:block;width:30px;height:30px;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(0,0,0,.14)}
  .bthp-crf__note[hidden]{display:none!important}
  .bthp-crf__col.is-in,.bthp-crf__slider.is-in{animation:bthpNotesIn .6s cubic-bezier(.2,.7,.2,1)}
  @keyframes bthpNotesIn{from{opacity:0;transform:translate3d(0,10px,0)}to{opacity:1;transform:none}}
  .bthp-crf__vers{display:flex;justify-content:center;gap:clamp(20px,3vw,40px)}
  .bthp-crf__ver{display:flex;flex-direction:column;align-items:center;gap:10px;border:0;padding:0;background:none;color:inherit;font:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}
  .bthp-crf__vc{position:relative;display:block;width:76px;height:76px;border-radius:50%;padding:5px;box-shadow:inset 0 0 0 1px rgba(248,244,239,.24);transition:box-shadow .3s ease}
  .bthp-crf__vc span,.bthp-crf__vc img{display:block;width:100%;height:100%;border-radius:50%;object-fit:cover;background:var(--c,#2a2a2a)}
  .bthp-crf__vc img{object-fit:contain;background:var(--c,rgba(248,244,239,.08))}
  .bthp-crf__ver:hover .bthp-crf__vc{box-shadow:inset 0 0 0 1px rgba(248,244,239,.6)}
  .bthp-crf__ver[aria-checked="true"] .bthp-crf__vc{box-shadow:inset 0 0 0 1.5px var(--bthp-ink)}
  .bthp-crf__vt{font-size:10px;font-weight:700;letter-spacing:.24em;text-transform:uppercase;opacity:.6;transition:opacity .3s ease}
  .bthp-crf__ver[aria-checked="true"] .bthp-crf__vt,.bthp-crf__ver:hover .bthp-crf__vt{opacity:1}
  .bthp-crf__vinfo{display:flex;flex-wrap:wrap;justify-content:center;align-items:baseline;gap:6px 14px;min-height:20px;text-align:center}
  .bthp-crf__vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .bthp-crf__vinfo [data-v-sub]{font-size:13px;opacity:.75}
  .bthp-crf__vlink{font-size:10px;font-weight:700;letter-spacing:.24em;text-transform:uppercase;color:inherit;text-decoration:none;border-bottom:1px solid var(--bthp-sand);padding-bottom:3px}
  .bthp-crf__vlink[hidden]{display:none}
  .bthp-crf__sel{margin:0;font-size:10px;font-weight:700;letter-spacing:.28em;text-transform:uppercase;opacity:.8}
  .bthp-crf__specs{position:relative;display:grid;grid-template-columns:repeat(var(--bthp-specs,4),minmax(0,1fr));margin-top:clamp(56px,6vw,88px);border-top:1px solid rgba(248,244,239,.16)}
  .bthp-crf__spec{display:flex;flex-direction:column;gap:8px;padding:32px 24px 0;text-align:center}
  .bthp-crf__spec+.bthp-crf__spec{border-left:1px solid rgba(248,244,239,.16)}
  .bthp-crf__spec b{font-family:var(--heading-font-family,"Playfair Display",serif);font-weight:400;font-style:italic;font-size:clamp(34px,3.4vw,52px);line-height:1}
  .bthp-crf__spec span{font-size:10px;font-weight:700;letter-spacing:.24em;text-transform:uppercase;opacity:.75}
  .bthp-crf__slider{display:none}
  @media (max-width:989px) and (min-width:750px){
    .bthp-crf__grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
    .bthp-crf__stage{grid-column:1 / -1;order:-1;max-width:560px;margin:0 auto;width:100%}
    .bthp-crf__col{gap:40px}
  }
  @media (max-width:749px){
    .bthp-crf{padding:48px 0 36px}
    .bthp-crf__wrap{padding:0 20px}
    .bthp-crf__head{gap:10px;margin-bottom:8px}
    .bthp-crf__h{font-size:calc(32px * var(--bthp-hs, 1))}
    .bthp-crf__grid{display:block}
    .bthp-crf__col{display:none}
    .bthp-crf__stage{max-width:230px;margin:0 auto}
    .bthp-crf__slider{display:flex;gap:8px;overflow-x:auto;scroll-snap-type:x mandatory;margin:8px -20px 0;padding:0 20px;scrollbar-width:none}
    .bthp-crf__slider::-webkit-scrollbar,.bthp-crf__row::-webkit-scrollbar,.bthp-crf__specs::-webkit-scrollbar{display:none}
    .bthp-crf__slider .bthp-crf__note{flex:0 0 62%;max-width:none;scroll-snap-align:start;padding:14px 14px 16px;gap:8px;box-shadow:inset 0 0 0 1px rgba(248,244,239,.16)}
    .bthp-crf__slider .bthp-crf__n::after{width:32px}
    .bthp-crf__note h3{font-size:18px}
    .bthp-crf__note p{font-size:12px;line-height:1.55}
    .bthp-crf__slider button.bthp-crf__note{align-items:flex-start;text-align:left}
    .bthp-crf__slider .bthp-crf__note.is-on{box-shadow:inset 0 0 0 1px var(--bthp-sand)}
    .bthp-crf.has-detail .bthp-crf__slider .bthp-crf__note:not(.is-on){opacity:.55}
    .bthp-crf__dimg figcaption{font-size:15px;padding:28px 12px 10px}
    .bthp-crf__back{top:6px;right:6px;width:34px;min-height:34px;padding:0;justify-content:center;gap:0}
    .bthp-crf__backl{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    .bthp-crf__pick{margin-top:16px;gap:8px}
    .bthp-crf__row{flex-wrap:nowrap;justify-content:flex-start;overflow-x:auto;max-width:100%;scrollbar-width:none;padding:2px}
    .bthp-crf .bthp-sw{flex:none;width:38px;height:38px}
    .bthp-crf .bthp-sw i{width:26px;height:26px}
    .bthp-crf__vers{gap:18px}
    .bthp-crf__vc{width:62px;height:62px;padding:4px}
    .bthp-crf__vt{font-size:9px;letter-spacing:.2em}
    .bthp-crf__specs{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;margin:22px -20px 0;padding:0 20px;border-top:0;scrollbar-width:none}
    .bthp-crf__spec,.bthp-crf__spec+.bthp-crf__spec{flex:0 0 36%;scroll-snap-align:start;padding:12px 6px;border:0;border-left:1px solid rgba(248,244,239,.16)}
    .bthp-crf__spec b{font-size:26px}
    .bthp-crf__spec span{font-size:9px;letter-spacing:.16em}
  }
  .bthp-off,.bthp-off *,.bthp-off *::before{animation-play-state:paused!important}
  @media (prefers-reduced-motion:reduce){.bthp-crf .bthp-sheen::before,.bthp-prod.is-in,.bthp-crf__col.is-in,.bthp-crf__slider.is-in{animation:none}.bthp-crf__dimg,.bthp-crf__stage .bthp-prod{transition:none}}
</style>

<div
  class="bthp-crf"
  id="craft"
  data-bthp-craft="{{ uid }}"
  data-smoke="{{ s.smoke }}"
  style="--bthp-bg: {{ s.bg }}; --bthp-ink: {{ s.ink }}; --bthp-sand: {{ s.sand }}; --bthp-specs: {{ specs.size | at_least: 1 }}; --bthp-hs-d: {{ section.settings.heading_size | divided_by: 100.0 }}; --bthp-hs-m: {{ section.settings.heading_size_mobile | divided_by: 100.0 }};"
>
  <div class="bthp-crf__glow" aria-hidden="true"></div>
  {%- if s.smoke -%}<canvas class="bthp-smoke" aria-hidden="true"></canvas>{%- endif -%}
  <div class="bthp-crf__wrap">
    <div class="bthp-crf__head">
      {%- if s.label != blank -%}<p class="bthp-crf__label">{{ s.label }}</p>{%- endif -%}
      <h2 class="bthp-crf__h">{{ s.heading }} {% if s.heading_italic != blank %}<em>{{ s.heading_italic }}</em>{% endif %}</h2>
    </div>
    <div class="bthp-crf__grid">
{%- liquid
  assign vis_n = 0
  for block in notes
    assign fv = block.settings.show_for | default: 'all'
    if vers.size == 0 or fv == 'all' or fv == '1'
      assign vis_n = vis_n | plus: 1
    endif
  endfor
  assign half = vis_n | plus: 1 | divided_by: 2 | floor
  assign col_l = ''
  assign col_r = ''
  assign col_h = ''
  assign sl = ''
  assign k = 0
-%}
{%- for block in notes -%}
  {%- assign nb = block.settings -%}
  {%- assign fv = nb.show_for | default: 'all' -%}
  {%- assign on = false -%}
  {%- if vers.size == 0 or fv == 'all' or fv == '1' -%}{%- assign on = true -%}{%- endif -%}
  {%- capture inner -%}<span class="bthp-crf__n">{{ nb.number }}</span><h3>{{ nb.title }}</h3><p>{{ nb.text }}</p>{% if nb.image != blank and s.more_label != blank %}<span class="bthp-crf__more">{{ s.more_label }}</span>{% endif %}{%- endcapture -%}
  {%- capture attrs %} data-d="{{ forloop.index0 }}" data-for="{% if vers.size == 0 %}all{% else %}{{ fv }}{% endif %}"{% unless on %} hidden{% endunless %}{%- endcapture -%}
  {%- if nb.image != blank -%}
    {%- capture nh -%}<button class="bthp-crf__note" type="button" aria-pressed="false"{{ attrs }} {{ block.shopify_attributes }}>{{ inner }}</button>{%- endcapture -%}
    {%- capture sh -%}<button class="bthp-crf__note" type="button" aria-pressed="false"{{ attrs }}>{{ inner }}</button>{%- endcapture -%}
  {%- else -%}
    {%- capture nh -%}<div class="bthp-crf__note"{{ attrs }} {{ block.shopify_attributes }}>{{ inner }}</div>{%- endcapture -%}
    {%- capture sh -%}<div class="bthp-crf__note"{{ attrs }}>{{ inner }}</div>{%- endcapture -%}
  {%- endif -%}
  {%- if on -%}
    {%- if k < half -%}{%- assign col_l = col_l | append: nh -%}{%- else -%}{%- assign col_r = col_r | append: nh -%}{%- endif -%}
    {%- assign k = k | plus: 1 -%}
  {%- else -%}
    {%- assign col_h = col_h | append: nh -%}
  {%- endif -%}
  {%- assign sl = sl | append: sh -%}
{%- endfor -%}
      <div class="bthp-crf__col" data-col-l>
        {{ col_l }}{{ col_h }}
      </div>
      <div class="bthp-crf__stage">
        <div class="bthp-prod" data-f-stage>
          {%- assign v0 = vers.first.settings.image -%}
          {%- if v0 != blank -%}
            {{ v0 | image_url: width: 1000 | image_tag: class: 'bthp-f-img', alt: vers.first.settings.title, loading: 'lazy', sizes: '(max-width: 749px) 230px, 40vw' }}
          {%- elsif s.image != blank -%}
            {{ s.image | image_url: width: 1000 | image_tag: class: 'bthp-f-img', alt: '', loading: 'lazy', sizes: '(max-width: 749px) 230px, 40vw' }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'bthp-f-ph' }}
          {%- endif -%}
          {%- if s.show_sheen -%}<span class="bthp-sheen" data-f-sheen></span>{%- endif -%}
        </div>
        <div class="bthp-crf__dm">
          {%- for block in notes -%}
            {%- if block.settings.image != blank -%}
              <figure class="bthp-crf__dimg" data-dimg="{{ forloop.index0 }}">
                {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 230px, 40vw', widths: '400,600,900,1200', alt: block.settings.title }}
                <figcaption><span>{{ block.settings.number }}</span>{{ block.settings.title }}</figcaption>
              </figure>
            {%- endif -%}
          {%- endfor -%}
          <button class="bthp-crf__back" type="button" data-back hidden><span class="bthp-crf__backl">{{ s.back_label }}</span> <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
        </div>
      </div>
      <div class="bthp-crf__col bthp-crf__col--r" data-col-r>
        {{ col_r }}
      </div>
    </div>
    <div class="bthp-crf__slider" data-col-s>
      {{ sl }}
    </div>
    {%- if vers.size > 0 -%}
      <div class="bthp-crf__pick" data-vers>
        <div class="bthp-crf__vers" role="radiogroup" aria-label="{{ s.picker_label | escape }}">
          {%- for block in vers -%}
            {%- assign vb = block.settings -%}
            {%- assign vthumb = vb.circle_image | default: vb.image -%}
            <button class="bthp-crf__ver" type="button" role="radio" aria-checked="{% if forloop.first %}true{% else %}false{% endif %}" data-v="{{ forloop.index0 }}"{% if vb.image != blank %} data-src="{{ vb.image | image_url: width: 1000 }}" data-srcset="{{ vb.image | image_url: width: 600 }} 600w, {{ vb.image | image_url: width: 1000 }} 1000w, {{ vb.image | image_url: width: 1400 }} 1400w"{% endif %} data-sub="{{ vb.subtitle | escape }}" data-url="{{ vb.link }}" data-ll="{{ vb.link_label | escape }}" {{ block.shopify_attributes }}>
              <span class="bthp-crf__vc" style="--c:{{ vb.circle_color }}">
