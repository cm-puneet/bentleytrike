{{ 'bt-foldable.css' | asset_url | stylesheet_tag }}
{%- render 'btf-style', s: section -%}
<script src="{{ 'bt-foldable.js' | asset_url }}" defer></script>

{%- assign img = section.settings.image | default: product.featured_media.preview_image -%}
{%- assign asset = section.settings.image_asset -%}
{%- if section.settings.image != blank -%}{%- assign asset = '' -%}{%- else -%}{%- if asset != blank -%}{%- assign img = nil -%}{%- endif -%}{%- endif -%}
{%- assign total = section.blocks.size | prepend: '0' | slice: -2, 2 -%}
<btf-hotspots class="btf btf-section btf-anchor" id="{{ section.settings.anchor | handleize }}" style="display: block">
  <div class="container">
    <div class="btf-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="btf-eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.intro != blank -%}<p class="btf-muted">{{ section.settings.intro | escape }}</p>{%- endif -%}
    </div>

    <div class="btf-hs__grid">
      <div class="btf-hs__stage">
        {%- if img or asset != blank -%}
          {%- render 'btf-image', image: img, asset: asset, widths: '500,800,1200', sizes: '(min-width: 800px) 50vw, 100vw', alt: section.settings.heading -%}
        {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'btf-placeholder' }}{%- endif -%}
        {%- for block in section.blocks -%}
          <button type="button" class="btf-hs__pin" data-go="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ block.settings.title | escape }}" style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%">{{ forloop.index }}</button>
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        <div class="btf-hs__panel" data-panel {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
          <div class="btf-hs__media">
            {%- if block.settings.video != blank -%}
              {{- block.settings.video | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', autoplay: forloop.first, image_size: '1600x' -}}
            {%- elsif block.settings.image != blank -%}
              {{- block.settings.image | image_url: width: 1600 | image_tag: widths: '500,750,1000,1300,1600', sizes: '(min-width: 800px) 50vw, 100vw', loading: 'lazy', alt: block.settings.image.alt | default: '' -}}
            {%- elsif block.settings.image_asset != blank -%}
              {%- render 'btf-image', asset: block.settings.image_asset, widths: '500,750,1000,1300,1600', sizes: '(min-width: 800px) 50vw, 100vw', loading: 'lazy', alt: block.settings.title -%}
            {%- endif -%}
          </div>
          <div class="btf-hs__body">
            <div class="btf-hs__count">
              <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }} <span>/ {{ total }}</span></span>
              <div class="btf-arrows">
                <button type="button" class="btf-arrow" data-step="-1" aria-label="Previous detail">{%- render 'icon' with 'chevron-left', width: 9, height: 13 -%}</button>
                <button type="button" class="btf-arrow btf-arrow--fill" data-step="1" aria-label="Next detail">{%- render 'icon' with 'chevron-right', width: 9, height: 13 -%}</button>
              </div>
            </div>
            <h3 class="h3">{{ block.settings.title | escape }}</h3>
            <p class="btf-muted">{{ block.settings.body | escape }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</btf-hotspots>

{%- comment -%} Images in the hidden panels start loading once the section is near, so switching shows them straight away. {%- endcomment -%}
<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || !('IntersectionObserver' in window)) return;
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      root.querySelectorAll('img[loading="lazy"]').forEach((img) => { img.loading = 'eager'; });
    }, { rootMargin: '600px 0px' });
    io.observe(root);
  })();
</script>

{% schema %}
{
  "name": "BT: Atelier hotspots",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "craft" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE ATELIER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Five details, finished like the cars." },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Tap a number on the trike, or step through the details." },
    { "type": "image_picker", "id": "image", "label": "Trike image" },
    { "type": "text", "id": "image_asset", "label": "Design file", "info": "Used when no image is picked. Clear it to use the product images.", "default": "btf-metamorphic.jpg" },
    {"type": "header", "content": "Colors", "info": "Leave a color empty to use the theme color."},
    {"type": "color", "id": "c_bg", "label": "Background", "default": "#f8f4ef"},
    {"type": "color", "id": "c_heading", "label": "Headings", "default": "#1a1a1a"},
    {"type": "color", "id": "c_text", "label": "Text", "default": "#1a1a1a"},
    {"type": "color", "id": "c_eyebrow", "label": "Eyebrow", "default": "#a83f2f"},
    {"type": "color", "id": "c_accent", "label": "Accent", "default": "#a83f2f", "info": "Active number and counter"},
    {"type": "color", "id": "c_card_bg", "label": "Card background", "default": "#ffffff"},
    {"type": "header", "content": "Typography"},
    {"type": "select", "id": "t_heading_font", "label": "Heading font", "options": [{"value": "heading", "label": "Theme heading font"}, {"value": "body", "label": "Theme body font"}], "default": "heading"},
    {"type": "range", "id": "t_heading_scale", "label": "Heading size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100},
    {"type": "range", "id": "t_text_scale", "label": "Text size", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100}
  ],
  "blocks": [
    {
      "type": "hotspot", "name": "Hotspot", "limit": 8,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Detail" },
        { "type": "textarea", "id": "body", "label": "Text" },
        { "type": "range", "id": "x", "label": "Horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "Vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "image_picker", "id": "image", "label": "Close-up image" },
        { "type": "text", "id": "image_asset", "label": "Design file", "info": "Used when no image is picked." },
        { "type": "video", "id": "video", "label": "Close-up video", "info": "Used instead of the image" }
      ]
    }
  ],
  "presets": [{ "name": "BT: Atelier hotspots" }]
}
{% endschema %}
