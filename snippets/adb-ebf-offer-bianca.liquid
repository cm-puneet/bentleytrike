            var skip = {};
            skip[box.dataset.productId] = true;
            (exWrap.getAttribute('data-trike-ids') || '').split(',').forEach(function (id) {
              if (id) skip[id] = true;
            });
            (cSel ? cSel.querySelectorAll('option') : []).forEach(function (op) {
              skip[op.getAttribute('data-model')] = true;
            });
            var exData = q('[data-ebf-ex-data]');
            var fromList = !!exData;
            var recBase = (box.dataset.recsUrl || base + 'recommendations/products').replace(/\/$/, '');
            var source = fromList
              ? Promise.resolve().then(function () {
                  return JSON.parse(exData.textContent);
                })
              : fetch(recBase + '.json?product_id=' + encodeURIComponent(box.dataset.productId) + '&limit=6&intent=complementary', {
                  credentials: 'same-origin',
                }).then(function (r) {
                  return r.ok ? r.json() : { products: [] };
                });
