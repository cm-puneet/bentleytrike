                  var shortWord = kw ? kw[0].toLowerCase() : shortName.split(' ').slice(-1)[0].toLowerCase();
                  add.setAttribute('data-short', shortWord + ' ' + fmt(v.price || 0).replace(/\.00(?=\D*$)/, ''));
