        if (bar) bar.style.opacity = o;
      }
      function clear() {
        last = -1; track.style.transform = '';
        allTexts.forEach(function (x) { x.style.opacity = ''; x.style.transform = ''; });
        if (bar) bar.style.opacity = '';
      }
      function onScroll() { if (on && near && !raf) raf = requestAnimationFrame(paint); }
      function setup() {
        var wantPx = el.getAttribute('data-parallax') !== 'false' && mq.matches && !!track;
        if (wantPx === on) { if (on) { measure(); onScroll(); } return; }
        on = wantPx;
        el.classList.toggle('is-px', on);
        if (on) { measure(); window.addEventListener('scroll', onScroll, opt({ passive: true })); paint(); }
        else { window.removeEventListener('scroll', onScroll); clear(); }
      }

      // One observer: tracks whether the hero is on (or near) the screen for autoplay, videos and the scroll effect.
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (en) {
          var was = seen; seen = near = en[0].isIntersecting;
          el.classList.toggle('bthp-off', !seen);
          if (seen && !was && live && !stopped) restartLine();
          if (near) onScroll();
          videos(); arm();
        }, { rootMargin: '150px 0px' });
        io.observe(el); observers.push(io);
      }
      // Theme editor: clicking a slide block shows that slide and holds it.
      if (edit) {
        document.addEventListener('shopify:block:select', function (e) {
          var k = slides.indexOf(e.target); if (k < 0) return;
          hold = true; clearTimeout(timer); go(k); clearTimeout(timer);
        }, opt());
        document.addEventListener('shopify:block:deselect', function (e) {
          if (slides.indexOf(e.target) < 0) return;
          hold = false; arm();
        }, opt());
        document.addEventListener('shopify:section:unload', function (e) {
          if (!e.target || !e.target.contains || !e.target.contains(el)) return;
          clearTimeout(timer); clearTimeout(rt); live = false;
          if (raf) cancelAnimationFrame(raf);
          observers.forEach(function (o) { o.disconnect(); });
          if (ac) ac.abort();
        }, opt());
      }
      var rt = 0;
      window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(function () { setup(); slides.forEach(posters); videos(); }, 150); }, opt({ passive: true }));
      setup();
    });
  })();
</script>

{% schema %}
{
  "name": "BT Hero slideshow",
  "class": "bthp-section",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Opening reveal" },
    { "type": "checkbox", "id": "show_intro", "label": "Play the opening reveal", "default": true },
    { "type": "checkbox", "id": "intro_once", "label": "Only on a visitor's first page view", "info": "Plays once per visit. In the theme editor it always plays.", "default": true },
    { "type": "text", "id": "intro_word", "label": "Wordmark", "default": "BENTLEY" },
    { "type": "text", "id": "intro_top", "label": "Line above wordmark", "default": "Officially licensed by Bentley Motors" },
    { "type": "text", "id": "intro_bottom", "label": "Line below wordmark", "default": "Trike" },
    { "type": "header", "content": "Slideshow" },
    { "type": "checkbox", "id": "autoplay", "label": "Move through slides by itself", "default": true },
    { "type": "range", "id": "speed", "label": "Time on each slide", "min": 4, "max": 12, "step": 1, "unit": "s", "default": 7 },
    { "type": "checkbox", "id": "pause_hover", "label": "Pause while the mouse is on the text or controls", "default": true },
    { "type": "checkbox", "id": "show_pause", "label": "Show pause button", "default": true, "info": "Lets visitors stop the slides. Recommended for accessibility." },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows (computer)", "default": true, "info": "On phones, people swipe or tap the lines." },
    { "type": "checkbox", "id": "show_counter", "label": "Show slide number (01 / 03)", "default": true },
    { "type": "text", "id": "label", "label": "Slideshow name (screen readers)", "default": "Bentley Trike highlights" },
    { "type": "header", "content": "Look" },
    { "type": "range", "id": "overlay", "label": "Darken images", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 10 },
    { "type": "select", "id": "height", "label": "Height (desktop)", "options": [{ "value": "full", "label": "Full screen" }, { "value": "large", "label": "Large" }], "default": "full" },
    { "type": "range", "id": "height_mobile", "label": "Height (phone)", "min": 40, "max": 100, "step": 2, "unit": "%", "default": 92, "info": "Share of the phone screen the slideshow fills. Lower it if the slides feel too tall; use Heading size (phone) to fit the text." },
    { "type": "checkbox", "id": "allow_transparent_header", "label": "Allow transparent header", "info": "Only applies when this section is first on the page.", "default": true },
    { "type": "checkbox", "id": "zoom", "label": "Slow zoom on each photo", "default": true, "info": "Computer only; phones keep the photo still." },
    { "type": "checkbox", "id": "parallax", "label": "Parallax effect", "default": true, "info": "The slides drift and the text fades as you scroll down. Computer only; phones always stay still." },
    { "type": "header", "content": "Text position (desktop)" },
    { "type": "select", "id": "align", "label": "Left / right", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "select", "id": "v_desktop", "label": "Up / down", "options": [{ "value": "top", "label": "Top" }, { "value": "middle", "label": "Middle" }, { "value": "bottom", "label": "Bottom" }, { "value": "split", "label": "Split: heading top, buttons bottom" }], "default": "bottom", "info": "Each slide can override this in its own settings." },
    { "type": "range", "id": "heading_width", "label": "Heading width", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 50, "info": "How much of the screen width the heading can use before it wraps." },
    { "type": "header", "content": "Text and buttons (phone)" },
    { "type": "select", "id": "align_mobile", "label": "Left / right", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "select", "id": "v_mobile", "label": "Up / down", "options": [{ "value": "top", "label": "Top (under the header)" }, { "value": "middle", "label": "Middle" }, { "value": "bottom", "label": "Bottom" }, { "value": "split", "label": "Split: heading top, buttons bottom" }], "default": "bottom", "info": "Each slide can override this. Use Split when the heading covers the car." },
    { "type": "range", "id": "edge_mobile", "label": "Extra space from the edge", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0, "info": "Pushes the text further from the top or bottom edge." },
    { "type": "checkbox", "id": "single_wide", "label": "Stretch a single button", "default": true, "info": "When a slide has only one button, it fills the button area (desktop and phone)." },
    { "type": "select", "id": "buttons_mobile", "label": "Buttons layout", "options": [{ "value": "side", "label": "Side by side, equal width" }, { "value": "stack", "label": "Stacked, full width" }, { "value": "fit", "label": "Fit to text" }], "default": "side", "info": "Use Stacked if long button labels look squeezed." },
