            setText(lab, sold ? 'Sold out' : origLabel);
            if (sold) return setText(sub, '');
            var subTxt = offer() === 'off' ? box.dataset.pct + '% off applied' : 'Free car included';
            var picked = box.querySelectorAll('[data-ebf-ex-add][aria-pressed="true"]');
