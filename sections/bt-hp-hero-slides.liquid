                <img {{ src_attr }}="{{ img_m | image_url: width: 1000 }}" {{ set_attr }}="{{ img_m | image_url: width: 500 }} 500w, {{ img_m | image_url: width: 1000 }} 1000w, {{ img_m | image_url: width: 1400 }} 1400w" sizes="100vw" width="{{ img_m.width }}" height="{{ img_m.height }}" alt="{{ img_m.alt | escape }}" decoding="async"{% if first %} fetchpriority="high"{% endif %}>
