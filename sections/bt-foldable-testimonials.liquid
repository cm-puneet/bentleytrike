{{ 'bt-foldable.css' | asset_url | stylesheet_tag }}
{%- render 'btf-style', s: section -%}

{%- comment -%} Customer testimonials, shown until the product has Okendo reviews of its own. Cards swipe sideways on mobile. {%- endcomment -%}
{%- assign review_count = product.metafields.okendo.ReviewCount.value | default: 0 -%}
{%- if section.settings.hide_from == 0 or review_count < section.settings.hide_from -%}
<div class="btf btf-section btf-anchor" id="{{ section.settings.anchor | handleize }}" data-btf-testimonials>
  <div class="container">
    <div class="btf-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="btf-eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<p class="btf-muted">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <div class="btf-quotes">
      {%- for block in section.blocks -%}
        <figure class="btf-quote" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <div class="btf-quote__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}<span{% if i > block.settings.rating %} class="is-off"{% endif %}>★</span>{%- endfor -%}
            </div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<span class="h5">{{ block.settings.title | escape }}</span>{%- endif -%}
          <blockquote>{{ block.settings.quote }}</blockquote>
          <figcaption>
            <span class="btf-quote__author">{{ block.settings.author | escape }}</span>
            {%- if block.settings.detail != blank -%}<span class="text-xs btf-muted">{{ block.settings.detail | escape }}</span>{%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "BT: testimonials",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "reviews" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FROM THE OWNERS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What parents say" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "range", "id": "hide_from", "label": "Hide once the product has this many reviews", "info": "Counted by Okendo. Match the reviews section's setting so one replaces the other. 0 = always show", "min": 0, "max": 10, "step": 1, "default": 1 },
    {"type": "header", "content": "Colors", "info": "Leave a color empty to use the theme color."},
    {"type": "color", "id": "c_bg", "label": "Background", "default": "#f8f4ef"},
    {"type": "color", "id": "c_heading", "label": "Headings", "default": "#1a1a1a"},
    {"type": "color", "id": "c_text", "label": "Text", "default": "#1a1a1a"},
    {"type": "color", "id": "c_eyebrow", "label": "Eyebrow", "default": "#a83f2f"},
    {"type": "color", "id": "c_accent", "label": "Accent", "default": "#a83f2f", "info": "Stars"},
    {"type": "color", "id": "c_card_bg", "label": "Card background", "default": "#d9d0c5"},
    {"type": "header", "content": "Typography"},
    {"type": "select", "id": "t_heading_font", "label": "Heading font", "options": [{"value": "heading", "label": "Theme heading font"}, {"value": "body", "label": "Theme body font"}], "default": "heading"},
    {"type": "range", "id": "t_heading_scale", "label": "Heading size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100},
    {"type": "range", "id": "t_text_scale", "label": "Text size", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100}
  ],
  "blocks": [
    {
      "type": "testimonial", "name": "Testimonial", "limit": 9,
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "info": "0 hides the stars", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>Share what a customer said.</p>" },
        { "type": "text", "id": "author", "label": "Name", "default": "Customer name" },
        { "type": "text", "id": "detail", "label": "Detail", "info": "E.g. the product they bought" }
      ]
    }
  ],
  "presets": [{ "name": "BT: testimonials", "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }] }]
}
{% endschema %}
