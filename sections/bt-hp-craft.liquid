{% schema %}
{
  "name": "BT The craft",
  "tag": "section",
  "class": "bthp-section",
  "max_blocks": 30,
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "The craft" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every detail," },
    { "type": "text", "id": "heading_italic", "label": "Heading (italic line)", "default": "a Bentley detail." },
    { "type": "header", "content": "Product in the spotlight" },
    { "type": "paragraph", "content": "Add a **Version** block for each version (Signature, Mulliner, Folding). Each one becomes a circle under the trike and shows its own photo. With no Version blocks, the circles follow the colours in the **BT Trike buy box** instead." },
    { "type": "image_picker", "id": "image", "label": "Image if there's no buy box", "info": "Optional. Shown only when the page has no Trike buy box." },
    { "type": "checkbox", "id": "show_picker", "label": "Show colour circles", "default": true, "info": "Used only when there are no Version blocks." },
    { "type": "header", "content": "Detail photos" },
    { "type": "text", "id": "more_label", "label": "Link under each detail", "default": "View the detail", "info": "Shown on details that have a photo." },
    { "type": "text", "id": "back_label", "label": "Back button", "default": "Show the trike" },
    { "type": "text", "id": "picker_label", "label": "Circles name (screen readers)", "default": "Choose a version" },
    { "type": "checkbox", "id": "show_sheen", "label": "Light sweep over the product", "default": true },
    { "type": "checkbox", "id": "smoke", "label": "Smoke trail behind the mouse", "default": true },
    { "type": "header", "content": "Heading size" },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100, "info": "The main heading only." },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (phone)", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#1a1a1a" },
    { "type": "color", "id": "ink", "label": "Text", "default": "#f8f4ef" },
    { "type": "color", "id": "sand", "label": "Accent (sand)", "default": "#d9d0c5" }
  ],
  "blocks": [
    {
      "type": "version",
      "name": "Version",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Signature" },
        { "type": "text", "id": "subtitle", "label": "Line under the circles", "default": "Eight Bentley colours", "info": "For example a price, \"From $599\", or a short description." },
