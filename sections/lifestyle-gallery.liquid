{% comment %}
  Bentley Trike – Lifestyle gallery. Editorial mosaic or swipeable row of lifestyle photos
  with optional captions and links. Joins the sticky hero's right column when placed after it.
{% endcomment %}

{%- assign s = section.settings -%}

<div data-bt-col>
  <bt-gallery
    class="bt-lg bt-lg--{{ s.layout }} bt-lg--m-{{ s.mobile_layout }}{% if s.top_line %} bt-lg--line{% endif %}"
    style="--bt-lg-bg: {{ s.c_bg }}; --bt-lg-text: {{ s.c_text }}; --bt-lg-muted: {{ s.c_text | color_modify: 'alpha', 0.7 }}; --bt-lg-line: {{ s.c_text | color_modify: 'alpha', 0.12 }}; --bt-lg-accent: {{ s.c_accent }}; --bt-lg-cap: {{ s.c_caption }}; --bt-lg-row: {{ s.row_height }}px; --bt-lg-gap: {{ s.gap }}px; --bt-lg-pt: {{ s.pad_top }}px; --bt-lg-pb: {{ s.pad_bottom }}px;"
  >
    {%- if s.eyebrow != blank or s.heading != blank or s.text != blank -%}
      <div class="bt-lg__head">
        {%- if s.eyebrow != blank -%}
          <p class="bt-lg__eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="bt-lg__h">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <p class="bt-lg__p">{{ s.text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bt-lg__wrap">
      <div class="bt-lg__grid" data-track>
        {%- for block in section.blocks -%}
          {%- assign img = block.settings.image -%}
          {%- capture inner -%}
            <span class="bt-lg__media">
              {%- if img != blank -%}
                {%- assign alt = img.alt | default: block.settings.caption | escape -%}
                {{ img | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '400,600,900,1200,1500,1800', sizes: '(min-width: 750px) 40vw, 80vw', alt: alt, style: block.settings.focal }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag }}
              {%- endif -%}
            </span>
            {%- if block.settings.caption != blank or block.settings.link != blank -%}
              <span class="bt-lg__cap">
                {%- if block.settings.caption != blank -%}
                  <span class="bt-lg__cap-t">{{ block.settings.caption }}</span>
                {%- endif -%}
                {%- if block.settings.link != blank and block.settings.link_label != blank -%}
                  <span class="bt-lg__cap-l">{{ block.settings.link_label }}</span>
                {%- endif -%}
              </span>
            {%- endif -%}
          {%- endcapture -%}
          {%- if block.settings.link != blank -%}
            <a class="bt-lg__item" href="{{ block.settings.link }}" data-reveal style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
              {{- inner -}}
            </a>
          {%- else -%}
            <div class="bt-lg__item" data-reveal style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
              {{- inner -}}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="bt-lg__arrows">
        <button type="button" class="bt-lg__arrow" data-prev aria-label="Previous photos">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
        </button>
        <button type="button" class="bt-lg__arrow" data-next aria-label="Next photos">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
        </button>
      </div>
    </div>
  </bt-gallery>
</div>

{% style %}
  .bt-lg {
    box-sizing: border-box;
    display: block;
    padding: var(--bt-lg-pt, 80px) clamp(20px, 4vw, 72px) var(--bt-lg-pb, 80px);
    background: var(--bt-lg-bg);
    color: var(--bt-lg-text);
  }
  .bt-lg * {
    box-sizing: border-box;
  }
  .bt-lg--line {
    border-top: 1px solid var(--bt-lg-line);
  }
  .bt-lg__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 640px;
    margin-bottom: 32px;
  }
  .bt-lg__eyebrow {
    margin: 0;
    color: var(--bt-lg-accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .bt-lg__h {
    margin: 0;
    color: var(--bt-lg-text);
    font-family: var(--heading-font-family, var(--font-heading-family, Georgia, serif));
    font-size: clamp(26px, 2.6vw, 38px);
    font-weight: 400;
    line-height: 1.1;
  }
  .bt-lg__p {
    margin: 0;
    color: var(--bt-lg-muted);
    font-size: 15px;
    line-height: 1.6;
  }
  .bt-lg__wrap {
    position: relative;
  }
  .bt-lg__item {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    background: rgba(26, 26, 26, 0.06);
    color: var(--bt-lg-cap);
    text-decoration: none;
  }
  .bt-lg__media {
    position: absolute;
    inset: 0;
    display: block;
  }
  .bt-lg__media img,
  .bt-lg__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bt-lg__item:hover .bt-lg__media img {
    transform: scale(1.05);
  }
  .bt-lg__cap {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 6px 16px;
    padding: 40px 16px 14px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.5) 100%);
    color: var(--bt-lg-cap);
  }
  .bt-lg__cap-t {
    font-family: var(--heading-font-family, var(--font-heading-family, Georgia, serif));
    font-size: 17px;
    line-height: 1.25;
  }
  .bt-lg__cap-l {
    padding-bottom: 2px;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 100% 100%;
    background-repeat: no-repeat;
    background-size: 100% 1px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background-size 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .bt-lg__item:hover .bt-lg__cap-l {
    background-size: 0 1px;
  }
  .bt-lg__item:focus-visible {
    outline: 2px solid var(--bt-lg-accent);
    outline-offset: 2px;
  }

  /* Reveal on scroll */
  .bt-lg.is-ready [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 24px, 0);
    transition: opacity 0.9s ease-out, transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i, 0) % 5 * 80ms);
  }
  .bt-lg.is-ready [data-reveal].is-in {
    opacity: 1;
    transform: none;
  }

  /* Mosaic: repeating 5-photo editorial pattern */
  .bt-lg--mosaic .bt-lg__grid {
    display: grid;
    grid-auto-flow: dense;
    grid-auto-rows: var(--bt-lg-row, 220px);
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--bt-lg-gap, 8px);
  }
  .bt-lg--mosaic .bt-lg__item:nth-child(5n + 1) {
    grid-column: span 4;
    grid-row: span 2;
  }
  .bt-lg--mosaic .bt-lg__item:nth-child(5n + 2),
  .bt-lg--mosaic .bt-lg__item:nth-child(5n + 3) {
    grid-column: span 2;
  }
  .bt-lg--mosaic .bt-lg__item:nth-child(5n + 4),
  .bt-lg--mosaic .bt-lg__item:nth-child(5n + 5) {
    grid-column: span 3;
    grid-row: span 2;
  }

  /* Swipe row */
  .bt-lg--row .bt-lg__grid {
    display: flex;
    gap: var(--bt-lg-gap, 8px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .bt-lg--row .bt-lg__grid::-webkit-scrollbar {
    display: none;
  }
  .bt-lg--row .bt-lg__item {
    flex: 0 0 clamp(240px, 38%, 420px);
    height: calc(var(--bt-lg-row, 220px) * 2);
    scroll-snap-align: start;
  }
  .bt-lg__arrows {
    display: none;
  }
  .bt-lg--row .bt-lg__arrows {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 16px;
  }
  .bt-lg__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--bt-lg-line);
    color: var(--bt-lg-text);
    cursor: pointer;
    transition: box-shadow 0.15s ease-in-out, opacity 0.15s ease-in-out;
  }
  .bt-lg__arrow:hover {
    box-shadow: inset 0 0 0 1px var(--bt-lg-text);
  }
  .bt-lg__arrow[disabled] {
    cursor: default;
    opacity: 0.35;
  }

  @media (max-width: 749px) {
    .bt-lg {
      padding: calc(var(--bt-lg-pt, 80px) * 0.7) 16px calc(var(--bt-lg-pb, 80px) * 0.7);
    }
    .bt-lg__cap-t {
      font-size: 15px;
    }
    /* Phone: swipe row */
    .bt-lg--m-row .bt-lg__grid {
      display: flex;
      gap: var(--bt-lg-gap, 8px);
      margin: 0 -16px;
      padding: 0 16px;
      overflow-x: auto;
      scroll-padding: 0 16px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .bt-lg--m-row .bt-lg__grid::-webkit-scrollbar {
      display: none;
    }
    .bt-lg--m-row .bt-lg__item,
    .bt-lg--m-row .bt-lg__item:nth-child(n) {
      flex: 0 0 78%;
      height: auto;
      aspect-ratio: 4 / 5;
      scroll-snap-align: start;
    }
    .bt-lg--m-row .bt-lg__arrows {
      display: none;
    }
    /* Phone: stacked grid (one large, then pairs) */
    .bt-lg--m-grid .bt-lg__grid {
      display: grid;
      grid-auto-rows: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--bt-lg-gap, 8px);
      overflow: visible;
    }
    .bt-lg--m-grid .bt-lg__item,
    .bt-lg--m-grid .bt-lg__item:nth-child(n) {
      grid-column: span 1;
      grid-row: auto;
      height: auto;
      aspect-ratio: 4 / 5;
    }
    .bt-lg--m-grid .bt-lg__item:nth-child(5n + 1) {
      grid-column: span 2;
      aspect-ratio: 4 / 3;
    }
    .bt-lg--m-grid .bt-lg__arrows {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bt-lg.is-ready [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .bt-lg__media img {
      transition: none;
    }
  }
{% endstyle %}

<script>
  (function () {
    if (customElements.get('bt-gallery')) return;
    customElements.define(
      'bt-gallery',
      class extends HTMLElement {
        connectedCallback() {
          var self = this;
          this.track = this.querySelector('[data-track]');
          var items = this.querySelectorAll('[data-reveal]');
          var editor = window.Shopify && window.Shopify.designMode;
          if ('IntersectionObserver' in window && !editor) {
            this.classList.add('is-ready');
            this.io = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (en) {
                  if (en.isIntersecting) {
                    en.target.classList.add('is-in');
                    self.io.unobserve(en.target);
                  }
                });
              },
              { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
            );
            items.forEach(function (it) {
              self.io.observe(it);
            });
          }
          var prev = this.querySelector('[data-prev]');
          var next = this.querySelector('[data-next]');
          var track = this.track;
          if (!track || !prev || !next) return;
          var step = function () {
            var first = track.querySelector('.bt-lg__item');
            return first ? first.getBoundingClientRect().width + 8 : track.clientWidth * 0.8;
          };
          var sync = function () {
            prev.disabled = track.scrollLeft < 4;
            next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
          };
          prev.addEventListener('click', function () {
            track.scrollBy({ left: -step(), behavior: 'smooth' });
          });
          next.addEventListener('click', function () {
            track.scrollBy({ left: step(), behavior: 'smooth' });
          });
          track.addEventListener('scroll', sync, { passive: true });
          window.addEventListener('resize', sync);
          sync();
        }
        disconnectedCallback() {
          if (this.io) this.io.disconnect();
        }
      }
    );
  })();
</script>

{% schema %}
{
  "name": "BT Lifestyle Gallery",
  "tag": "section",
  "class": "bt-gallery-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The Bentley life" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "From first strolls to <em>first drives</em>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every Trike leaves with a free Bentley Ride-On Car for the next chapter." },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "default": "mosaic",
      "options": [
        { "value": "mosaic", "label": "Editorial mosaic" },
        { "value": "row", "label": "Swipe row with arrows" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Phone layout",
      "default": "row",
      "options": [
        { "value": "row", "label": "Swipe row" },
        { "value": "grid", "label": "Stacked grid" }
      ]
    },
    { "type": "range", "id": "row_height", "label": "Photo height (desktop)", "min": 120, "max": 400, "step": 10, "unit": "px", "default": 220, "info": "Large photos are twice this height" },
    { "type": "range", "id": "gap", "label": "Space between photos", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "checkbox", "id": "top_line", "label": "Show divider line on top", "default": true },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#f8f4ef" },
    { "type": "color", "id": "c_text", "label": "Text", "default": "#1a1a1a" },
    { "type": "color", "id": "c_accent", "label": "Accent", "default": "#a83f2f" },
    { "type": "color", "id": "c_caption", "label": "Caption text on photos", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional – e.g. the product in the photo" },
        { "type": "text", "id": "link_label", "label": "Link text", "default": "Shop the look" },
        {
          "type": "select",
          "id": "focal",
          "label": "Crop focus",
          "default": "object-position: 50% 50%;",
          "options": [
            { "value": "object-position: 50% 50%;", "label": "Centre" },
            { "value": "object-position: 50% 15%;", "label": "Top" },
            { "value": "object-position: 50% 85%;", "label": "Bottom" },
            { "value": "object-position: 20% 50%;", "label": "Left" },
            { "value": "object-position: 80% 50%;", "label": "Right" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BT Lifestyle Gallery",
      "blocks": [
        { "type": "photo", "settings": { "caption": "Golden-hour strolls" } },
        { "type": "photo", "settings": { "caption": "Two Bentleys in the family" } },
        { "type": "photo", "settings": { "caption": "Built for cobblestones" } },
        { "type": "photo", "settings": { "caption": "Their first Bentley" } },
        { "type": "photo", "settings": { "caption": "Grows with your child" } }
      ]
    }
  ]
}
{% endschema %}