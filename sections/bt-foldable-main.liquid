      "content": "Gallery"
    },
    {
      "type": "select",
      "id": "gallery_source",
      "label": "Gallery images",
      "options": [
        { "value": "auto", "label": "Automatic" },
        { "value": "product", "label": "Product images" },
        { "value": "section", "label": "Lifestyle images below" }
      ],
      "default": "auto",
      "info": "Automatic uses the product's own images once it has 2 or more, otherwise the lifestyle images below."
    },
    {
      "type": "range",
      "id": "media_limit",
      "label": "Product images to show",
      "info": "After the main image",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "paragraph",
      "content": "Labels on product images come from their alt text in admin: write \"STROLLER MODE | Mother pushing the trike\". The part before | is the label, the rest describes the image. Alt text without | shows no label."
    },
