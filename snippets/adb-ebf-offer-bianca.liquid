            if (o === 'car' && cSel && cSel.value) {
              var carOpt = cSel.selectedOptions[0];
              items.push(withPreorder({ id: Number(cSel.value), quantity: 1, properties: { _adb_offer: 'free-car' } }, carOpt && carOpt.getAttribute('data-qty')));
            }
            box.querySelectorAll('[data-ebf-ex-add][aria-pressed="true"]').forEach(function (x) {
              items.push(withPreorder({ id: Number(x.getAttribute('data-ebf-ex-add')), quantity: 1 }));
            });
            var detail = { sections: [] };
            document.dispatchEvent(new CustomEvent('cart:prepare-bundled-sections', { bubbles: true, detail: detail }));
            var code = o === 'off' ? box.dataset.code : '';
            var done = function () {
              running = false;
              if (btn) btn.removeAttribute('aria-busy');
              setText(lab, origLabel);
            };
            json('cart/add.js', { items: items })
              .then(function () {
                return json('cart/update.js', { discount: code, sections: detail.sections.join(',') });
              })
              .then(function (cart) {
                // "Buy with Shop" → Shop Pay sign-in (shop.app), with the offer already in the cart.
                if (goCheckout === 'shop_pay') return (window.location.href = base + 'checkout?payment=shop_pay');
                var after = goCheckout ? 'checkout' : box.dataset.after;
                if (after === 'checkout') return (window.location.href = base + 'checkout');
                if (after === 'cart') return (window.location.href = base + 'cart');
                document.dispatchEvent(new CustomEvent('variant:add', { bubbles: true, detail: { items: items, cart: cart } }));
                document.documentElement.dispatchEvent(
                  new CustomEvent('cart:change', {
                    bubbles: true,
                    detail: { baseEvent: 'variant:add', onSuccessDo: 'force_open_drawer', cart: cart },
                  })
                );
                done();
              })
              .catch(function (e) {
                done();
                showErr((e && (e.description || e.message)) || 'Something went wrong, please try again.');
              });
          };
          if (btn) {
            btn.addEventListener('click', function () {
              if (btn.getAttribute('aria-busy') === 'true') return;
              run(false);
            });
          }
          // Express buttons: stop Shopify's own "buy this one item" flow and run the offer instead.
          var pay = q('[data-ebf-pay]');
          // Shopify draws its button a moment after the page loads, at its own height –
          // match Add to cart to it so the two always line up.
          // If Shopify's button needs more room than its half of the row (narrow phones),
          // scale it down to fit instead of letting the logo get cut off.
          var fitShop = function () {
            if (!pay || !btn) return false;
            var sb = pay.querySelector('shopify-accelerated-checkout, .shopify-payment-button__button');
            if (!sb) return false;
            sb.style.zoom = '';
            sb.style.removeProperty('height');
            sb.style.removeProperty('min-height');
            var have = pay.clientWidth;
            var need = Math.max(sb.scrollWidth, sb.getBoundingClientRect().width);
            if (!(have > 0 && need > have + 1)) return false;
            // Scaled: keep it the same visible height as Add to cart.
            btn.style.height = '';
            btn.style.minHeight = '';
            var H = btn.getBoundingClientRect().height;
            var z = Math.max(0.6, have / need);
            sb.style.zoom = String(z);
            sb.style.setProperty('height', H / z + 'px', 'important');
            sb.style.setProperty('min-height', H / z + 'px', 'important');
            return true;
          };
          var matchHeights = function () {
            if (!pay || !btn) return;
            if (fitShop()) return;
            var sb = pay.querySelector('.shopify-payment-button__button, shopify-accelerated-checkout');
            var h = sb ? Math.round(sb.getBoundingClientRect().height) : 0;
            if (h >= 36 && h <= 80) {
              btn.style.height = h + 'px';
              btn.style.minHeight = h + 'px';
            }
          };
          // Shopify sometimes shows its plain "Buy it now" instead of Buy with Shop.
          // Dress it as the Shop button and add "More payment options" back underneath.
          var dressPay = function () {
            if (!pay) return;
            var ub = pay.querySelector('.shopify-payment-button__button--unbranded');
            if (!ub || ub.getAttribute('data-ebf-dressed') === '1') return;
            ub.setAttribute('data-ebf-dressed', '1');
            pay.classList.add('is-unbranded');
            ub.innerHTML = '<span>Buy with</span><b>Shop</b>';
            ub.setAttribute('aria-label', 'Buy with Shop');
            var wrap = ub.closest('.shopify-payment-button') || ub.parentNode;
            if (wrap && !wrap.querySelector('.shopify-payment-button__more-options')) {
              var more = document.createElement('button');
              more.type = 'button';
              more.className = 'shopify-payment-button__more-options bt-ebf__more-opt';
              more.textContent = 'More payment options';
              wrap.appendChild(more);
            }
          };
          if (pay) {
            dressPay();
            if (window.MutationObserver) new MutationObserver(dressPay).observe(pay, { childList: true, subtree: true });
          }
          if (pay && btn) {
            matchHeights();
            if (window.ResizeObserver) new ResizeObserver(matchHeights).observe(pay);
            [300, 1000, 2500].forEach(function (ms) {
              setTimeout(matchHeights, ms);
            });
            window.addEventListener('resize', matchHeights);
          }
          if (pay) {
            pay.addEventListener(
              'click',
              function (e) {
                if (!e.target.closest('.shopify-payment-button')) return;
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();
                // "More payment options" → normal checkout. "Buy with Shop" → Shop Pay sign-in.
                run(e.target.closest('.shopify-payment-button__more-options') ? true : 'shop_pay');
              },
              true
            );
            pay.addEventListener('submit', function (e) {
              e.preventDefault();
            });
          }
        }
      }
    );
  })();
</script>
{%- endif -%}