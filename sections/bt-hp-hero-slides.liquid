{%- comment -%}
  BT Homepage — Opening reveal + Hero slideshow (v2)
  Same look as "BT Hero + reveal", with several slides. Each slide has its own
  photo or video, headline, small details, text and buttons. Slides crossfade with a
  slow zoom; thin progress lines along the bottom show which slide is playing.
  v2: text can sit at the top, middle or bottom (desktop and phone, per slide if wanted),
  phone button layouts (side by side / stacked / fit to text), pause button,
  keyboard arrows, no reveal flash on repeat visits, hidden-size photos never download.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign word = s.intro_word | default: 'BENTLEY' | upcase
  assign letters = word | split: ''
  assign slides = section.blocks | where: 'type', 'slide'
  assign n = slides.size
  assign blank_gif = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=='
  assign v_d = s.v_desktop | default: 'bottom'
  assign v_m = s.v_mobile | default: 'bottom'
  assign btn_m = s.buttons_mobile | default: 'side'
-%}

<style>
  .bthp-hss{--bthp-hz:var(--bthp-hz-d,1)}
  @media (max-width:749px){.bthp-hss{--bthp-hz:var(--bthp-hz-m,1)}}
  .bthp-hss{position:relative;height:var(--bthp-h,100vh);height:var(--bthp-h,100svh);min-height:600px;max-height:1000px;overflow:hidden;background:#0b0b0a;color:var(--bthp-text);contain:paint}
  .bthp-hss[data-transparent]{margin-block-start:calc(-1 * var(--header-height, 0px) * var(--section-is-first, 0))}
  .bthp-hss__track{position:absolute;inset:0;backface-visibility:hidden}
  .bthp-hss.is-px .bthp-hss__track{will-change:transform}
  .bthp-hss__slide{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity 1.2s ease,visibility 0s linear 1.2s}
  .bthp-hss__slide.is-on{opacity:1;visibility:visible;transition:opacity 1.2s ease,visibility 0s linear 0s;z-index:1}
  .bthp-hss__media{position:absolute;inset:0}
  /* Slow zoom on the playing slide: computer only (phones keep the photo still to save battery) */
  @media (min-width:750px) and (prefers-reduced-motion:no-preference){
    .bthp-hss[data-zoom="true"] .bthp-hss__media{transform:scale3d(1.08,1.08,1);transition:transform 0s linear 1.3s}
    .bthp-hss[data-zoom="true"] .bthp-hss__slide.is-in .bthp-hss__media{transform:scale3d(1,1,1);transition:transform calc(var(--bthp-dur,7s) + 1.2s) linear;will-change:transform}
    .bthp-hss.bthp-off .bthp-hss__slide.is-in .bthp-hss__media{will-change:auto}
  }
  .bthp-hss__media img,.bthp-hss__media video,.bthp-hss__media svg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:var(--pd,50% 50%)}
  .bthp-hss__media .bthp-hss__m{display:none}
  .bthp-hss__shade{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(0,0,0,calc(var(--bthp-ov) + .3)) 0%,rgba(0,0,0,calc(var(--bthp-ov) * .3)) 28%,rgba(0,0,0,calc(var(--bthp-ov) * .5)) 50%,rgba(0,0,0,calc(var(--bthp-ov) + .5)) 100%)}

  /* Darken behind text (per slide): a soft shadow only where the text sits */
  .bthp-hss__side{position:absolute;inset:0;z-index:1;pointer-events:none;--a:var(--sd,0);--b:calc(var(--sd,0) * .55)}
  /* Text area fills the slide; its contents sit at the top, middle or bottom */
  .bthp-hss__in{position:absolute;z-index:2;inset:0;display:flex;flex-direction:column;justify-content:flex-end;max-width:1440px;margin:0 auto;box-sizing:border-box;pointer-events:none;padding:calc(var(--header-height,90px) + 32px) clamp(20px,4.4vw,64px) calc(clamp(36px,6vh,64px) + 56px)}
  .bthp-hss__in>*{pointer-events:auto}
  .bthp-hss__h{margin:0 0 clamp(28px,4vh,44px);max-width:var(--bthp-hw,50%);font-family:var(--heading-font-family,"Playfair Display",serif);font-weight:400;font-size:calc(clamp(52px,6.4vw,112px) * var(--bthp-hz, 1));line-height:.9;letter-spacing:-.02em;color:var(--bthp-text)}
  .bthp-hss__ln{display:block;overflow:hidden;padding:0 .08em .24em;margin:0 -.08em -.24em}
  .bthp-hss__ln>span{display:block;transform:translate3d(0,160%,0);transition:transform 0s linear .9s}
  .bthp-hss__slide.is-in .bthp-hss__ln>span{transform:none;transition:transform 1.3s cubic-bezier(.2,.7,.2,1) .25s}
  .bthp-hss__slide.is-in .bthp-hss__ln+.bthp-hss__ln>span{transition-delay:.4s}
  .bthp-hss__gilt{font-style:italic;background:linear-gradient(180deg,var(--bthp-text) 25%,var(--bthp-sand) 80%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-box-decoration-break:clone;box-decoration-break:clone;padding:0 .1em .24em;margin:0 -.1em -.24em}
  .bthp-hss__foot{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,440px);gap:40px;align-items:end;opacity:0;transform:translate3d(0,16px,0);transition:opacity .4s ease,transform 0s linear .4s}
  .bthp-hss__slide.is-in .bthp-hss__foot{opacity:1;transform:none;transition:opacity 1s ease .6s,transform 1.1s cubic-bezier(.2,.7,.2,1) .6s}
  .bthp-hss__lede{max-width:min(560px,var(--bthp-hw,50%));margin:calc(14px - clamp(28px,4vh,44px)) 0 clamp(24px,3.4vh,36px);font-family:var(--text-font-family,Poppins,sans-serif);font-size:17px;line-height:1.6;opacity:0;transform:translate3d(0,14px,0);transition:opacity .4s ease,transform 0s linear .4s}
  .bthp-hss__slide.is-in .bthp-hss__lede{opacity:.92;transform:none;transition:opacity 1s ease .5s,transform 1.1s cubic-bezier(.2,.7,.2,1) .5s}
  .bthp-hss__meta{display:flex;flex-wrap:wrap;gap:10px 28px;align-items:center}
  .bthp-hss__meta span{font-family:var(--text-font-family,Poppins,sans-serif);font-size:10px;font-weight:700;letter-spacing:.26em;text-transform:uppercase;opacity:.85}
  .bthp-hss__sub{margin:0 0 20px;font-family:var(--text-font-family,Poppins,sans-serif);font-size:15px;line-height:1.7;opacity:.92}
  .bthp-hss__ctas{display:flex;flex-wrap:wrap;gap:12px}
  .bthp-hss__btn{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:0 34px;box-sizing:border-box;border-radius:0;font-family:var(--text-font-family,Poppins,sans-serif);font-weight:700;font-size:12px;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;text-align:center;transition:background .3s ease,color .3s ease,box-shadow .3s ease}
  .bthp-hss__btn--a{background:var(--bthp-btn-bg);color:var(--bthp-btn-text)}
  .bthp-hss__btn--a:hover{background:var(--bthp-btn-text);color:var(--bthp-btn-bg)}
  .bthp-hss__btn--b{background:transparent;color:var(--bthp-text);box-shadow:inset 0 0 0 1px currentColor}
  .bthp-hss__btn--b:hover{background:var(--bthp-text);color:#1a1a1a}
  .bthp-hss__btn:focus-visible{outline:1px solid var(--bthp-text);outline-offset:3px}
  /* Only one button on a slide: stretch it across the button area (setting "Stretch a single button") */
  .bthp-hss[data-single="true"] .bthp-hss__act.is-single .bthp-hss__btn{flex:1 1 100%;width:100%}

  /* Controls: counter, one thin progress line per slide, pause, arrows */
  .bthp-hss__bar{position:absolute;left:0;right:0;bottom:0;z-index:3;max-width:1440px;margin:0 auto;padding:0 clamp(20px,4.4vw,64px) clamp(28px,4vh,40px);box-sizing:border-box;display:flex;align-items:center;gap:24px;font-family:var(--text-font-family,Poppins,sans-serif);opacity:0;transition:opacity 1s ease}
  .bthp-hss.is-live .bthp-hss__bar{opacity:1}
  .bthp-hss__count{flex:none;font-size:10px;font-weight:700;letter-spacing:.26em;font-variant-numeric:tabular-nums;opacity:.85}
  .bthp-hss__lines{flex:1;display:flex;gap:8px;min-width:0}
  .bthp-hss__line{position:relative;flex:1;height:24px;padding:0;border:0;background:transparent;cursor:pointer}
  .bthp-hss__line::before,.bthp-hss__line i{content:"";position:absolute;left:0;right:0;top:50%;height:1px;margin-top:-.5px}
  .bthp-hss__line::before{background:rgba(255,255,255,.3)}
  .bthp-hss__line i{background:var(--bthp-text);transform:scaleX(0);transform-origin:0 50%}
  .bthp-hss__line.is-done i{transform:none}
  .bthp-hss__line.is-on i{animation:bthpHssA var(--bthp-dur,7s) linear forwards}
  .bthp-hss__line.is-on.is-odd i{animation-name:bthpHssB}
  .bthp-hss.is-hold .bthp-hss__line.is-on i,.bthp-hss.is-stopped .bthp-hss__line.is-on i,.bthp-hss.bthp-off .bthp-hss__line.is-on i{animation-play-state:paused}
  .bthp-hss.is-still .bthp-hss__line.is-on i{animation:none;transform:none}
  @keyframes bthpHssA{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  @keyframes bthpHssB{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  .bthp-hss__arw{flex:none;display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:0;border-radius:50%;background:transparent;color:var(--bthp-text);box-shadow:inset 0 0 0 1px rgba(255,255,255,.4);cursor:pointer;transition:box-shadow .3s ease,background .3s ease}
  .bthp-hss__arw:hover{box-shadow:inset 0 0 0 1px var(--bthp-text)}
  .bthp-hss__arws{flex:none;display:flex;gap:8px}
  .bthp-hss__pp .bthp-hss__i-play,.bthp-hss.is-stopped .bthp-hss__pp .bthp-hss__i-pause{display:none}
  .bthp-hss.is-stopped .bthp-hss__pp .bthp-hss__i-play{display:block}
  .bthp-hss__line:focus-visible,.bthp-hss__arw:focus-visible{outline:1px solid var(--bthp-text);outline-offset:3px}

  /* Desktop: text position */
  @media (min-width:750px){
    .bthp-hss__foot>div:last-child{grid-column:2}
    .bthp-hss__slide[data-vd="middle"] .bthp-hss__in{justify-content:center}
    .bthp-hss__slide[data-vd="top"] .bthp-hss__in{justify-content:flex-start}
    .bthp-hss__slide[data-vd="split"] .bthp-hss__in{justify-content:space-between}
    .bthp-hss__slide[data-vd="split"] .bthp-hss__lede{margin-top:0}
    .bthp-hss__slide[data-al="left"] .bthp-hss__side{background:linear-gradient(90deg,rgba(0,0,0,var(--a)) 0%,rgba(0,0,0,var(--b)) 38%,rgba(0,0,0,0) 68%)}
    .bthp-hss__slide[data-al="right"] .bthp-hss__side{background:linear-gradient(270deg,rgba(0,0,0,var(--a)) 0%,rgba(0,0,0,var(--b)) 38%,rgba(0,0,0,0) 68%)}
    .bthp-hss__slide[data-al="center"] .bthp-hss__side{background:radial-gradient(ellipse 75% 65% at 50% var(--cy,72%),rgba(0,0,0,var(--a)) 0%,rgba(0,0,0,var(--b)) 45%,rgba(0,0,0,0) 100%)}
    .bthp-hss__slide[data-vd="middle"] .bthp-hss__side{--cy:50%}
    .bthp-hss__slide[data-vd="top"] .bthp-hss__side{--cy:30%}
    .bthp-hss__slide[data-vd="split"] .bthp-hss__side{--cy:50%}
    .bthp-hss__slide[data-al="center"] .bthp-hss__h{text-align:center;margin-left:auto;margin-right:auto}
    .bthp-hss__slide[data-al="right"] .bthp-hss__h{text-align:right;margin-left:auto}
    .bthp-hss__slide[data-al="center"] .bthp-hss__lede{text-align:center;margin-left:auto;margin-right:auto}
    .bthp-hss__slide[data-al="right"] .bthp-hss__lede{text-align:right;margin-left:auto}
    .bthp-hss__slide[data-al="center"] .bthp-hss__foot,.bthp-hss__slide[data-al="right"] .bthp-hss__foot{display:flex;flex-direction:column;gap:22px}
    .bthp-hss__slide[data-al="center"] .bthp-hss__foot{align-items:center;text-align:center}
    .bthp-hss__slide[data-al="right"] .bthp-hss__foot{align-items:flex-end;text-align:right}
    .bthp-hss__slide[data-al="center"] .bthp-hss__foot>div:last-child,.bthp-hss__slide[data-al="right"] .bthp-hss__foot>div:last-child{max-width:560px}
    .bthp-hss__slide[data-al="center"] .bthp-hss__meta,.bthp-hss__slide[data-al="right"] .bthp-hss__meta{order:2}
    .bthp-hss__slide[data-al="center"] .bthp-hss__meta,.bthp-hss__slide[data-al="center"] .bthp-hss__ctas{justify-content:center}
    .bthp-hss__slide[data-al="right"] .bthp-hss__meta,.bthp-hss__slide[data-al="right"] .bthp-hss__ctas{justify-content:flex-end}
    .bthp-hss[data-single="true"] .bthp-hss__slide[data-al="center"] .bthp-hss__act.is-single,.bthp-hss[data-single="true"] .bthp-hss__slide[data-al="right"] .bthp-hss__act.is-single{width:100%;max-width:440px}
  }

  /* Opening reveal (same as BT Hero + reveal) */
  .bthp-intro{position:fixed;inset:0;z-index:999;pointer-events:none}
  .bthp-hss.is-plain .bthp-intro{display:none}
  .bthp-intro__p{position:absolute;left:0;right:0;height:50.5%;background:var(--bthp-intro-bg);overflow:hidden;will-change:transform}
  .bthp-intro__p--t{top:0;animation:bthpIpT 3.6s cubic-bezier(.76,0,.24,1) forwards}
  .bthp-intro__p--b{bottom:0;animation:bthpIpB 3.6s cubic-bezier(.76,0,.24,1) forwards}
  @keyframes bthpIpT{0%,46%{transform:translate3d(0,0,0)}62%,72%{transform:translate3d(0,-26%,0)}100%{transform:translate3d(0,-101%,0)}}
  @keyframes bthpIpB{0%,46%{transform:translate3d(0,0,0)}62%,72%{transform:translate3d(0,26%,0)}100%{transform:translate3d(0,101%,0)}}
  .bthp-intro__m{position:absolute;left:50%;color:var(--bthp-intro-text)}
  .bthp-intro__p--t .bthp-intro__m{bottom:0;transform:translate(-50%,50%)}
  .bthp-intro__p--b .bthp-intro__m{top:0;transform:translate(-50%,-50%)}
  .bthp-intro__row{position:relative;display:flex;align-items:center;gap:clamp(14px,2.4vw,32px)}
  .bthp-intro__line{display:block;width:min(16vw,200px);height:1px;background:var(--bthp-sand);transform:scaleX(0);animation:bthpLine 1.2s cubic-bezier(.2,.7,.2,1) .2s forwards}
  .bthp-intro__line--l{transform-origin:100% 50%}
  .bthp-intro__line--r{transform-origin:0 50%}
  @keyframes bthpLine{to{transform:scaleX(1)}}
  .bthp-intro__word{display:flex;font-family:var(--heading-font-family,"Playfair Display",serif);font-weight:400;font-size:clamp(34px,5vw,72px);line-height:1;letter-spacing:.3em;margin-right:-.3em;white-space:nowrap}
  .bthp-intro__word span{display:inline-block;opacity:0;transform:translate3d(0,36%,0);animation:bthpL 1s cubic-bezier(.2,.7,.2,1) forwards}
  @keyframes bthpL{to{opacity:1;transform:none}}
  .bthp-intro__sub,.bthp-intro__sup{position:absolute;left:0;right:0;margin:0;text-align:center;font-family:var(--text-font-family,Poppins,sans-serif);font-size:9px;font-weight:700;text-transform:uppercase;opacity:0;animation:bthpS .9s ease forwards}
  .bthp-intro__sub{top:calc(100% + 22px);letter-spacing:.62em;margin-right:-.62em;color:var(--bthp-sand);animation-delay:1.2s}
  .bthp-intro__sup{bottom:calc(100% + 22px);letter-spacing:.5em;margin-right:-.5em;color:var(--bthp-intro-text);animation-delay:.9s}
  @keyframes bthpS{to{opacity:.75}}

  /* Phone */
  @media (max-width:749px){
    .bthp-hss{height:var(--bthp-hmv,92vh);height:var(--bthp-hm,92svh);min-height:340px}
    .bthp-hss__media .bthp-hss__d{display:none}
    .bthp-hss__media .bthp-hss__m{display:block}
    .bthp-hss__media img,.bthp-hss__media video,.bthp-hss__media svg{object-position:var(--pm,50% 50%)}
    .bthp-hss__in{padding:calc(var(--header-height,64px) + 16px + var(--bthp-edge,0px)) 20px calc(76px + var(--bthp-edge,0px))}
    .bthp-hss__slide[data-vm="middle"] .bthp-hss__in{justify-content:center}
    .bthp-hss__slide[data-vm="top"] .bthp-hss__in{justify-content:flex-start}
    /* Split: heading at the top, details and buttons at the bottom (keeps the middle of the photo clear) */
    .bthp-hss__slide[data-vm="split"] .bthp-hss__in{justify-content:space-between}
    .bthp-hss__slide[data-vm="split"] .bthp-hss__lede{margin-top:0}
    /* Phone: text spans the width, so the shadow follows where it sits up/down */
    .bthp-hss__slide[data-vm="bottom"] .bthp-hss__side{background:linear-gradient(0deg,rgba(0,0,0,var(--a)) 0%,rgba(0,0,0,var(--b)) 35%,rgba(0,0,0,0) 65%)}
    .bthp-hss__slide[data-vm="top"] .bthp-hss__side{background:linear-gradient(180deg,rgba(0,0,0,var(--a)) 0%,rgba(0,0,0,var(--b)) 35%,rgba(0,0,0,0) 65%)}
    .bthp-hss__slide[data-vm="middle"] .bthp-hss__side{background:linear-gradient(180deg,rgba(0,0,0,0) 12%,rgba(0,0,0,var(--b)) 32%,rgba(0,0,0,var(--b)) 68%,rgba(0,0,0,0) 88%)}
    .bthp-hss__slide[data-vm="split"] .bthp-hss__side{background:linear-gradient(180deg,rgba(0,0,0,var(--a)) 0%,rgba(0,0,0,0) 34%,rgba(0,0,0,0) 62%,rgba(0,0,0,var(--a)) 100%)}
    .bthp-hss__h{max-width:none;font-size:calc(48px * var(--bthp-hz, 1));margin-bottom:22px}
    .bthp-hss__lede{max-width:none;margin:-10px 0 18px;font-size:15px}
    .bthp-hss__foot{grid-template-columns:minmax(0,1fr);gap:16px}
    .bthp-hss__meta{gap:6px 16px}
    .bthp-hss__meta span{font-size:9px;letter-spacing:.2em}
    .bthp-hss[data-metam="false"] .bthp-hss__meta{display:none}
    .bthp-hss[data-subm="false"] .bthp-hss__sub{display:none}
    .bthp-hss__slide[data-alm="center"] .bthp-hss__in{text-align:center}
    .bthp-hss__slide[data-alm="right"] .bthp-hss__in{text-align:right}
    .bthp-hss__slide[data-alm="center"] .bthp-hss__meta,.bthp-hss__slide[data-alm="center"] .bthp-hss__ctas{justify-content:center}
    .bthp-hss__slide[data-alm="right"] .bthp-hss__meta,.bthp-hss__slide[data-alm="right"] .bthp-hss__ctas{justify-content:flex-end}
    .bthp-hss__sub{font-size:14px;margin-bottom:16px}
    /* Phone buttons: side by side (default) */
    .bthp-hss__ctas{flex-wrap:nowrap;gap:10px}
    .bthp-hss__btn{flex:1 1 0;min-width:0;padding:0 10px;min-height:50px;font-size:11px;letter-spacing:.14em}
    /* Stacked, full width */
    .bthp-hss[data-btnm="stack"] .bthp-hss__ctas{flex-direction:column}
    .bthp-hss[data-btnm="stack"] .bthp-hss__btn{flex:none;width:100%}
    /* Fit to text */
    .bthp-hss[data-btnm="fit"] .bthp-hss__ctas{flex-wrap:wrap}
    .bthp-hss[data-btnm="fit"] .bthp-hss__btn{flex:0 0 auto;padding:0 24px}
    .bthp-hss[data-single="true"] .bthp-hss__act.is-single .bthp-hss__btn{flex:1 1 100%;width:100%;padding:0 16px}
    .bthp-hss__bar{padding:0 20px 22px;gap:14px}
    .bthp-hss__arws{display:none}
    .bthp-hss__pp{width:36px;height:36px}
    .bthp-intro__line{width:12vw}
  }
  @media (prefers-reduced-motion:reduce){
    .bthp-intro{display:none}
    .bthp-hss__media,.bthp-hss__slide.is-on .bthp-hss__media{transform:none;transition:none}
    .bthp-hss__ln>span,.bthp-hss__foot,.bthp-hss__lede{transform:none;opacity:1;transition:none}
  }
</style>

<div
  class="bthp-hss{% if s.show_intro %} is-intro{% else %} is-plain{% endif %}"
  data-bthp-hss
  data-once="{{ s.intro_once }}"
  data-auto="{{ s.autoplay }}"
  data-secs="{{ s.speed }}"
  data-hover="{{ s.pause_hover }}"
  data-metam="{% if s.meta_mobile == false %}false{% else %}true{% endif %}"
  data-subm="{% if s.text_mobile == false %}false{% else %}true{% endif %}"
  data-parallax="{% if s.parallax == false %}false{% else %}true{% endif %}"
  data-zoom="{% if s.zoom == false %}false{% else %}true{% endif %}"
  data-al="{{ s.align }}"
  data-alm="{{ s.align_mobile }}"
