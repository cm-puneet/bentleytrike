{{ 'bt-foldable.css' | asset_url | stylesheet_tag }}
{%- render 'btf-style', s: section -%}
<script src="{{ 'bt-foldable.js' | asset_url }}" defer></script>

<btf-rail class="btf btf-section btf-anchor" id="{{ section.settings.anchor | handleize }}" style="display: block">
  <div class="container btf-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="btf-eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="btf-arrows">
      <button type="button" class="btf-arrow" data-step="-1" aria-label="Previous">{%- render 'icon' with 'chevron-left', width: 9, height: 13 -%}</button>
      <button type="button" class="btf-arrow btf-arrow--fill" data-step="1" aria-label="Next">{%- render 'icon' with 'chevron-right', width: 9, height: 13 -%}</button>
    </div>
  </div>
  <div class="btf-rail">
    {%- for block in section.blocks -%}
      {%- assign img = block.settings.image | default: product.media[block.settings.fallback_media].preview_image -%}
      {%- assign asset = block.settings.asset -%}
      {%- if block.settings.image != blank -%}{%- assign asset = '' -%}{%- elsif asset != blank -%}{%- assign img = nil -%}{%- endif -%}
      <article {{ block.shopify_attributes }}>
        {%- if block.settings.video != blank -%}
          <div class="btf-video">{{- block.settings.video | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', image_size: '750x', class: 'btf-autovideo' -}}</div>
        {%- elsif img or asset != blank -%}
          {%- render 'btf-image', image: img, asset: asset, widths: '300,500,750,1000', sizes: '(min-width: 1000px) 30vw, 260px', alt: block.settings.title -%}
        {%- else -%}<span class="btf-placeholder"></span>{%- endif -%}
        <span class="btf-eyebrow">{{ block.settings.age | escape }}</span>
        <span class="h4">{{ block.settings.title | escape }}</span>
        <span class="text-sm btf-muted">{{ block.settings.text | escape }}</span>
      </article>
    {%- endfor -%}
  </div>
</btf-rail>

{% schema %}
{
  "name": "BT: stages rail",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "stages" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW IT GROWS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From first walk to first solo ride" },
    {"type": "header", "content": "Colors", "info": "Leave a color empty to use the theme color."},
    {"type": "color", "id": "c_bg", "label": "Background", "default": "#f8f4ef"},
    {"type": "color", "id": "c_heading", "label": "Headings", "default": "#1a1a1a"},
    {"type": "color", "id": "c_text", "label": "Text", "default": "#1a1a1a"},
    {"type": "color", "id": "c_eyebrow", "label": "Eyebrow", "default": "#a83f2f"},
    {"type": "header", "content": "Typography"},
    {"type": "select", "id": "t_heading_font", "label": "Heading font", "options": [{"value": "heading", "label": "Theme heading font"}, {"value": "body", "label": "Theme body font"}], "default": "heading"},
    {"type": "range", "id": "t_heading_scale", "label": "Heading size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100},
    {"type": "range", "id": "t_text_scale", "label": "Text size", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100}
  ],
  "blocks": [
    {
      "type": "stage", "name": "Stage", "limit": 8,
      "settings": [
        { "type": "text", "id": "age", "label": "Age", "default": "10 MONTHS+" },
        { "type": "text", "id": "title", "label": "Title", "default": "Stroller" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Design file", "info": "Used when no image is picked" },
        { "type": "video", "id": "video", "label": "Video", "info": "E.g. this mode's transformation clip. Plays instead of the image (muted, loops while in view)" },
        { "type": "range", "id": "fallback_media", "label": "If no image, use product image #", "info": "0 = first", "min": 0, "max": 10, "step": 1, "default": 0 }
      ]
    }
  ],
  "presets": [{ "name": "BT: stages rail" }]
}
{% endschema %}
