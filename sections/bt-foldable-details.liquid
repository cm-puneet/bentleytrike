{{ 'bt-foldable.css' | asset_url | stylesheet_tag }}
{%- render 'btf-style', s: section -%}

{%- comment -%} Product details (accordion), downloads (manuals, assembly PDFs) and spare parts. Downloads and parts without a link stay hidden on the storefront. {%- endcomment -%}
{%- liquid
  assign downloads = section.blocks | where: 'type', 'download'
  assign parts = section.blocks | where: 'type', 'part'
  assign has_downloads = false
  for block in downloads
    if block.settings.url != blank
      assign has_downloads = true
    endif
  endfor
  assign has_parts = false
  if section.settings.parts_link != blank
    assign has_parts = true
  endif
  for block in parts
    if block.settings.product != blank
      assign has_parts = true
    endif
  endfor
  assign first_open = true
-%}
<div class="btf btf-section btf-details btf-anchor" id="{{ section.settings.anchor | handleize }}">
  <div class="container">
    <div class="btf-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="btf-eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<p class="btf-muted">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>

    <div class="btf-details__grid">
      <div class="btf-details__info">
        {%- for block in section.blocks -%}
          {%- liquid
            assign body = ''
            case block.type
              when 'description'
                assign body = product.description
              when 'detail'
                assign body = block.settings.content
            endcase
          -%}
          {%- if body != blank -%}
            <details {% if first_open and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
              <summary class="h6">{{ block.settings.title | escape }}</summary>
              <div class="prose">{{ body }}</div>
            </details>
            {%- assign first_open = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if has_downloads or has_parts or request.design_mode -%}
        <aside class="btf-details__aside">
          {%- if has_downloads or request.design_mode -%}
            <div class="btf-details__card">
              <span class="h6">{{ section.settings.downloads_heading | escape }}</span>
              <ul class="btf-downloads" role="list">
                {%- for block in downloads -%}
                  {%- if block.settings.url != blank -%}
                    <li {{ block.shopify_attributes }}>
                      <a href="{{ block.settings.url }}" target="_blank" rel="noopener" class="btf-download">
                        {%- render 'icon' with 'picto-document', width: 24, height: 24 -%}
                        <span><span class="btf-download__title">{{ block.settings.title | escape }}</span>{%- if block.settings.meta != blank -%}<span class="text-xs btf-muted">{{ block.settings.meta | escape }}</span>{%- endif -%}</span>
                        <span class="btf-download__go" aria-hidden="true">↓</span>
                      </a>
                    </li>
                  {%- elsif request.design_mode -%}
                    <li class="btf-download btf-muted" {{ block.shopify_attributes }}>
                      {%- render 'icon' with 'picto-document', width: 24, height: 24 -%}
                      <span><span class="btf-download__title">{{ block.settings.title | escape }}</span><span class="text-xs">Add a file link to show this</span></span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if has_parts or request.design_mode -%}
            <div class="btf-details__card">
              <span class="h6">{{ section.settings.parts_heading | escape }}</span>
              {%- if section.settings.parts_text != blank -%}<p class="text-sm btf-muted">{{ section.settings.parts_text | escape }}</p>{%- endif -%}
              {%- if parts.size > 0 -%}
                <ul class="btf-parts" role="list">
                  {%- for block in parts -%}
                    {%- assign p = block.settings.product -%}
                    {%- if p != blank -%}
                      <li {{ block.shopify_attributes }}>
                        <a href="{{ p.url }}" class="btf-part">
                          {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 160 | image_tag: widths: '80,160', sizes: '64px', loading: 'lazy', alt: '' }}{%- endif -%}
                          <span><span class="btf-download__title">{{ block.settings.title | default: p.title | escape }}</span><span class="text-xs btf-muted">{{ p.price | money }}</span></span>
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if section.settings.parts_link != blank -%}
                <a href="{{ section.settings.parts_link }}" class="link text-sm btf-details__more">{{ section.settings.parts_link_label | escape }} →</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </aside>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BT: details & downloads",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "details" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE DETAILS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything about your Foldable Trike" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first detail", "default": true },
    { "type": "header", "content": "Downloads" },
    { "type": "text", "id": "downloads_heading", "label": "Heading", "default": "Manuals & guides" },
    { "type": "paragraph", "content": "Upload PDFs in Content > Files, copy the link, and paste it into a Download block." },
    { "type": "header", "content": "Spare parts" },
    { "type": "text", "id": "parts_heading", "label": "Heading", "default": "Spare parts" },
    { "type": "text", "id": "parts_text", "label": "Text", "default": "Lost a cap or need a new wheel? Order replacement parts." },
    { "type": "url", "id": "parts_link", "label": "Link" },
    { "type": "text", "id": "parts_link_label", "label": "Link label", "default": "Shop spare parts" },
    {"type": "header", "content": "Colors", "info": "Leave a color empty to use the theme color."},
    {"type": "color", "id": "c_bg", "label": "Background", "default": "#ffffff"},
    {"type": "color", "id": "c_heading", "label": "Headings", "default": "#1a1a1a"},
    {"type": "color", "id": "c_text", "label": "Text", "default": "#1a1a1a"},
    {"type": "color", "id": "c_eyebrow", "label": "Eyebrow", "default": "#a83f2f"},
    {"type": "color", "id": "c_card_bg", "label": "Card background", "default": "#d9d0c5"},
    {"type": "header", "content": "Typography"},
    {"type": "select", "id": "t_heading_font", "label": "Heading font", "options": [{"value": "heading", "label": "Theme heading font"}, {"value": "body", "label": "Theme body font"}], "default": "heading"},
    {"type": "range", "id": "t_heading_scale", "label": "Heading size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100},
    {"type": "range", "id": "t_text_scale", "label": "Text size", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100}
  ],
  "blocks": [
    {
      "type": "description", "name": "Product description", "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Product details" },
        { "type": "paragraph", "content": "Shows the product's description from the product page in admin. Hidden when it's empty." }
      ]
    },
    {
      "type": "detail", "name": "Detail",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Specifications" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    },
    {
      "type": "download", "name": "Download",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Owner's manual" },
        { "type": "text", "id": "meta", "label": "Details", "default": "PDF" },
        { "type": "url", "id": "url", "label": "File link", "info": "Paste the file's link from Content > Files" }
      ]
    },
    {
      "type": "part", "name": "Spare part",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the product title" }
      ]
    }
  ],
  "presets": [{ "name": "BT: details & downloads", "blocks": [{ "type": "description" }, { "type": "detail" }, { "type": "download" }] }]
}
{% endschema %}
