{{ 'bt-foldable.css' | asset_url | stylesheet_tag }}
{%- render 'btf-style', s: section -%}

<div class="btf btf-section btf-anchor" id="{{ section.settings.anchor | handleize }}">
  <div class="container">
    <div class="btf-head">
      <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <div class="btf-cells">
      {%- for block in section.blocks -%}
        <div class="btf-cell" {{ block.shopify_attributes }}>
          {%- if block.settings.icon_image != blank -%}
            {{- block.settings.icon_image | image_url: width: 96 | image_tag: class: 'btf-cell__icon', width: 32, height: 32, loading: 'lazy', alt: '' -}}
          {%- elsif block.settings.icon != 'none' -%}
            <span class="btf-cell__icon">{%- render 'icon' with block.settings.icon, width: 32, height: 32 -%}</span>
          {%- endif -%}
          <span class="h5">{{ block.settings.title | escape }}</span>
          <span class="text-sm btf-muted">{{ block.settings.text | escape }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BT: guarantee",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "care" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy with confidence." },
    { "type": "textarea", "id": "text", "label": "Text" },
    {"type": "header", "content": "Colors", "info": "Leave a color empty to use the theme color."},
    {"type": "color", "id": "c_bg", "label": "Background", "default": "#f8f4ef"},
    {"type": "color", "id": "c_heading", "label": "Headings", "default": "#1a1a1a"},
    {"type": "color", "id": "c_text", "label": "Text", "default": "#1a1a1a"},
    {"type": "color", "id": "c_eyebrow", "label": "Eyebrow", "default": "#a83f2f"},
    {"type": "color", "id": "c_accent", "label": "Accent", "default": "#a83f2f", "info": "Icons"},
    {"type": "color", "id": "c_card_bg", "label": "Card background", "default": "#f8f4ef"},
    {"type": "header", "content": "Typography"},
    {"type": "select", "id": "t_heading_font", "label": "Heading font", "options": [{"value": "heading", "label": "Theme heading font"}, {"value": "body", "label": "Theme body font"}], "default": "heading"},
    {"type": "range", "id": "t_heading_scale", "label": "Heading size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100},
    {"type": "range", "id": "t_text_scale", "label": "Text size", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100}
  ],
  "blocks": [
    {
      "type": "item", "name": "Guarantee", "limit": 6,
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "picto-shield",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "picto-shield", "label": "Shield" },
            { "value": "picto-return", "label": "Return" },
            { "value": "picto-customer-support", "label": "Customer support" },
            { "value": "picto-award-gift", "label": "Award" },
            { "value": "picto-validation", "label": "Check mark" },
            { "value": "picto-truck", "label": "Truck" },
            { "value": "picto-box", "label": "Box" },
            { "value": "picto-secure-profile", "label": "Secure" },
            { "value": "picto-lock", "label": "Lock" },
            { "value": "picto-credit-card", "label": "Credit card" },
            { "value": "picto-chat", "label": "Chat" },
            { "value": "picto-star", "label": "Star" },
            { "value": "picto-love", "label": "Heart" }
          ]
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon", "info": "Used instead of the icon. 64 × 64 px or larger" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text", "info": "Keep it to one short line" }
      ]
    }
  ],
  "presets": [{ "name": "BT: guarantee" }]
}
{% endschema %}
