                      pp.textContent = fmt(nv.price || 0);
                      add.setAttribute('data-short', shortWord + ' ' + fmt(nv.price || 0).replace(/\.00(?=\D*$)/, ''));
                      var nimg = (nv.featured_image && nv.featured_image.src) || '';
                      if (nimg) {
                        if (nimg.indexOf('//') === 0) nimg = 'https:' + nimg;
                        var cur = pic.querySelector('img');
