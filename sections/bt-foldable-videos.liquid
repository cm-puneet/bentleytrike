{{ 'bt-foldable.css' | asset_url | stylesheet_tag }}
{%- render 'btf-style', s: section -%}

{%- comment -%} How-to videos (assembly, transformation, folding). Videos load only when played (preload none, poster image). Hidden until a video is picked. {%- endcomment -%}
{%- liquid
  assign has_video = false
  for block in section.blocks
    if block.settings.video != blank
      assign has_video = true
    endif
  endfor
-%}
{%- if has_video or request.design_mode -%}
  <div class="btf btf-section btf-anchor" id="{{ section.settings.anchor | handleize }}">
    <div class="container">
      <div class="btf-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}<div class="btf-eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        </div>
        {%- if section.settings.text != blank -%}<p class="btf-muted">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      <div class="btf-guides__grid">
        {%- for block in section.blocks -%}
          {%- assign v = block.settings.video -%}
          {%- if v != blank or request.design_mode -%}
            <article class="btf-guide{% if v.aspect_ratio < 1 %} btf-guide--vertical{% endif %}" {{ block.shopify_attributes }}>
              {%- if v != blank -%}
                {{- v | video_tag: controls: true, playsinline: true, preload: 'none', image_size: '1000x' -}}
              {%- else -%}
                <div class="btf-placeholder" style="aspect-ratio: 16 / 9"></div>
              {%- endif -%}
              <span class="h5">{{ block.settings.title | escape }}</span>
              {%- if block.settings.text != blank -%}<span class="text-sm btf-muted">{{ block.settings.text | escape }}</span>{%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "BT: video guides",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "videos" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SEE IT IN ACTION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Assembly, transformation and folding" },
    { "type": "text", "id": "text", "label": "Text" },
    {"type": "header", "content": "Colors", "info": "Leave a color empty to use the theme color."},
    {"type": "color", "id": "c_bg", "label": "Background", "default": "#f8f4ef"},
    {"type": "color", "id": "c_heading", "label": "Headings", "default": "#1a1a1a"},
    {"type": "color", "id": "c_text", "label": "Text", "default": "#1a1a1a"},
    {"type": "color", "id": "c_eyebrow", "label": "Eyebrow", "default": "#a83f2f"},
    {"type": "header", "content": "Typography"},
    {"type": "select", "id": "t_heading_font", "label": "Heading font", "options": [{"value": "heading", "label": "Theme heading font"}, {"value": "body", "label": "Theme body font"}], "default": "heading"},
    {"type": "range", "id": "t_heading_scale", "label": "Heading size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100},
    {"type": "range", "id": "t_text_scale", "label": "Text size", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100}
  ],
  "blocks": [
    {
      "type": "video", "name": "Video", "limit": 6,
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Upload in Content > Files, then pick it here. The card is hidden until a video is picked." },
        { "type": "text", "id": "title", "label": "Title", "default": "Assembly" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "BT: video guides", "blocks": [{ "type": "video" }] }]
}
{% endschema %}
