      "type": "bt-foldable-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What are the dimensions and weight?",
            "answer": "<p>32.5 × 20 × 41.5 in assembled. Net weight 9.67 kg (21.3 lb); 11.35 kg boxed.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "What age and size is it for?",
            "answer": "<p>10 to 72 months, children 72–115 cm tall, up to 25 kg (55 lb). One rider at a time.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How do I take it in the car or on a trip?",
            "answer": "<p>Fold it with the seat attached, clip on the included travel wheels and roll it like luggage. The included storage bag keeps it clean; unzip the canopy edge before bagging.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Can I stop the pedals turning while I push?",
            "answer": "<p>Yes. The pedal clutch in the centre of the front wheel switches the front free-wheel on, so the pedals stay still until your child is ready.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "What comes in the box?",
            "answer": "<p>Pre-assembled base, seat and backrest, safety guard, infant footrests, push handle, canopy set, cupholder, quilted handle bag, tricycle-mode cap, rear B logos, tool and manual, plus a storage bag and travel wheels.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "What is it made of, and how do I clean it?",
            "answer": "<p>Metal frame with PVC, PP, ABS and TPR parts. Wipe with a damp sponge or cloth; do not submerge it. Store it out of direct sunlight to protect the fabric.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "What does the warranty cover?",
            "answer": "<p>Defects in materials and workmanship for 1–2 years by region. It does not cover normal wear, incorrect assembly, misuse, sun fading or commercial use.</p>"
          }
        }
      },
