{% comment %}
  Bentley Trike – Closing call to action with countdown. Joins the sticky hero's right column when placed after it.
{% endcomment %}

{%- assign ai = section.id | replace: '_', '' | downcase -%}
{%- assign s = section.settings -%}
{%- assign show_cd = false -%}
{%- if s.show_countdown and s.offer_end != blank -%}{%- assign show_cd = true -%}{%- endif -%}

{% style %}
  .cc-{{ ai }} {
    --bg: {{ s.c_bg }};
    --text: {{ s.c_text }};
    --label: {{ s.c_label }};
    --btn-bg: {{ s.c_btn_bg }};
    --btn-text: {{ s.c_btn_text }};
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px; text-align: center;
    min-height: {{ s.min_height }}px; background: var(--bg); color: var(--text);
    padding: 72px clamp(20px, 4vw, 72px);
  }
  .cc-{{ ai }} * { box-sizing: border-box; }
  .cc-{{ ai }}__label { margin: 0; font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--label); }
  .cc-{{ ai }}__h { margin: 0; max-width: 620px; font-family: var(--heading-font-family, var(--font-heading-family, Georgia, serif)); font-weight: 400; font-size: clamp(30px, 3vw, 46px); line-height: 1.08; color: var(--text); }
  .cc-{{ ai }}__p { margin: 0; max-width: 480px; font-size: 15px; line-height: 1.6; color: var(--label); }
  .cc-{{ ai }}__btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 56px; padding: 0 36px; max-width: 100%;
    background: var(--btn-bg); color: var(--btn-text); font-weight: 700; font-size: 14px; letter-spacing: .08em; text-transform: uppercase;
    text-decoration: none; transition: filter .15s ease-in-out;
  }
  .cc-{{ ai }}__btn:hover { filter: brightness(.88); color: var(--btn-text); }
  @media (max-width: 749px) {
    .cc-{{ ai }} { padding: 56px 16px; min-height: 0; }
    .cc-{{ ai }}__btn { width: 100%; }
  }
{% endstyle %}

<div data-bt-col>
  <section class="cc-{{ ai }}">
    {%- if show_cd -%}
      <p class="cc-{{ ai }}__label" data-cc-countdown="{{ s.offer_end | escape }}">
        {{ s.countdown_prefix }}
        <span data-cc-left>—</span>
      </p>
    {%- elsif s.label != blank -%}
      <p class="cc-{{ ai }}__label">{{ s.label }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h2 class="cc-{{ ai }}__h">{{ s.heading }}</h2>
    {%- endif -%}
    {%- if s.text != blank -%}
      <p class="cc-{{ ai }}__p">{{ s.text }}</p>
    {%- endif -%}
    {%- if s.button_label != blank -%}
      <a class="cc-{{ ai }}__btn" href="{{ s.button_link | default: '#bt-claim' }}">{{ s.button_label }}</a>
    {%- endif -%}
  </section>
</div>

{%- if show_cd -%}
  <script>
    (function () {
      var el = document.querySelector('.cc-{{ ai }} [data-cc-countdown]');
      if (!el || el.dataset.ready) return;
      el.dataset.ready = '1';
      var m = String(el.getAttribute('data-cc-countdown') || '')
        .trim()
        .match(/^(\d{4})-(\d{1,2})-(\d{1,2})(?:[ T](\d{1,2}):(\d{2}))?/);
      var out = el.querySelector('[data-cc-left]');
      if (!m || !out) {
        el.hidden = true;
        return;
      }
      var end = new Date(+m[1], +m[2] - 1, +m[3], m[4] ? +m[4] : 23, m[5] ? +m[5] : 59, 59);
      function tick() {
        var left = Math.max(0, Math.floor((end - new Date()) / 1000));
        out.textContent = Math.floor(left / 86400) + 'd ' + Math.floor((left % 86400) / 3600) + 'h ' + Math.floor((left % 3600) / 60) + 'm';
      }
      tick();
      setInterval(tick, 30000);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "BT Closing CTA",
  "tag": "section",
  "class": "bt-cta-section",
  "settings": [
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": true },
    { "type": "text", "id": "countdown_prefix", "label": "Countdown text", "default": "This page closes in" },
    {
      "type": "text",
      "id": "offer_end",
      "label": "Offer ends",
      "default": "2026-11-30 23:59",
      "info": "YYYY-MM-DD HH:MM in the shopper’s local time"
    },
    { "type": "text", "id": "label", "label": "Small label (if no countdown)", "default": "Private offer" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Some deals are shared. <em>This one is whispered.</em>" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Claim my free car" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to jump to the bundle builder" },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (desktop)",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#00221c" },
    { "type": "color", "id": "c_text", "label": "Heading", "default": "#ffffff" },
    { "type": "color", "id": "c_label", "label": "Small text", "default": "#d9d0c5" },
    { "type": "color", "id": "c_btn_bg", "label": "Button background", "default": "#a83f2f" },
    { "type": "color", "id": "c_btn_text", "label": "Button text", "default": "#ffffff" }
  ],
  "presets": [{ "name": "BT Closing CTA" }]
}
{% endschema %}