{%- comment -%}
  BT Homepage — Opening reveal + Hero slideshow
  Same look as "BT Hero + reveal", but with several slides. Each slide has its own
  photo or video, headline, small details, text and buttons. Slides crossfade with a
  slow zoom; thin progress lines along the bottom show which slide is playing.
  Speed: only the slide on screen (and the next one) downloads its photo; every
  animation moves transform/opacity only; autoplay stops when the hero is off
  screen or the tab is hidden; videos play only on the slide that is showing.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign word = s.intro_word | default: 'BENTLEY' | upcase
  assign letters = word | split: ''
  assign slides = section.blocks | where: 'type', 'slide'
  assign n = slides.size
-%}

<style>
  .bthp-hss{--bthp-hz:var(--bthp-hz-d,1)}
  @media (max-width:749px){.bthp-hss{--bthp-hz:var(--bthp-hz-m,1)}}
  .bthp-hss{position:relative;height:var(--bthp-h,100vh);height:var(--bthp-h,100svh);min-height:600px;max-height:1000px;overflow:hidden;background:#0b0b0a;color:var(--bthp-text)}
  .bthp-hss[data-transparent]{margin-block-start:calc(-1 * var(--header-height, 0px) * var(--section-is-first, 0))}
  .bthp-hss__track{position:absolute;inset:0;backface-visibility:hidden}
  .bthp-hss.is-px .bthp-hss__track{will-change:transform}
  .bthp-hss__slide{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity 1.2s ease,visibility 0s linear 1.2s}
  .bthp-hss__slide.is-on{opacity:1;visibility:visible;transition:opacity 1.2s ease,visibility 0s linear 0s;z-index:1}
  .bthp-hss__media{position:absolute;inset:0}
  /* Slow zoom on the playing slide: computer only (phones keep the photo still to save battery) */
  @media (min-width:750px) and (prefers-reduced-motion:no-preference){
    .bthp-hss[data-zoom="true"] .bthp-hss__media{transform:scale3d(1.08,1.08,1);transition:transform 0s linear 1.3s}
    .bthp-hss[data-zoom="true"] .bthp-hss__slide.is-in .bthp-hss__media{transform:scale3d(1,1,1);transition:transform calc(var(--bthp-dur,7s) + 1.2s) linear;will-change:transform}
    .bthp-hss.bthp-off .bthp-hss__slide.is-in .bthp-hss__media{will-change:auto}
  }
  .bthp-hss__media img,.bthp-hss__media video,.bthp-hss__media svg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:var(--pd,50% 50%)}
  .bthp-hss__media .bthp-hss__m{display:none}
  .bthp-hss__shade{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(0,0,0,calc(var(--bthp-ov) + .3)) 0%,rgba(0,0,0,calc(var(--bthp-ov) * .3)) 28%,rgba(0,0,0,calc(var(--bthp-ov) * .5)) 50%,rgba(0,0,0,calc(var(--bthp-ov) + .5)) 100%)}
  .bthp-hss__in{position:absolute;z-index:2;left:0;right:0;bottom:0;padding:0 clamp(20px,4.4vw,64px) calc(clamp(36px,6vh,64px) + 56px);max-width:1440px;margin:0 auto;box-sizing:border-box}
  .bthp-hss__h{margin:0 0 clamp(28px,4vh,44px);max-width:var(--bthp-hw,50%);font-family:var(--heading-font-family,"Playfair Display",serif);font-weight:400;font-size:calc(clamp(52px,6.4vw,112px) * var(--bthp-hz, 1));line-height:.9;letter-spacing:-.02em;color:var(--bthp-text)}
  .bthp-hss__ln{display:block;overflow:hidden;padding:0 .08em .24em;margin:0 -.08em -.24em}
  .bthp-hss__ln>span{display:block;transform:translate3d(0,160%,0);transition:transform 0s linear .9s}
  .bthp-hss__slide.is-in .bthp-hss__ln>span{transform:none;transition:transform 1.3s cubic-bezier(.2,.7,.2,1) .25s}
  .bthp-hss__slide.is-in .bthp-hss__ln+.bthp-hss__ln>span{transition-delay:.4s}
  .bthp-hss__gilt{font-style:italic;background:linear-gradient(180deg,var(--bthp-text) 25%,var(--bthp-sand) 80%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-box-decoration-break:clone;box-decoration-break:clone;padding:0 .1em .24em;margin:0 -.1em -.24em}
  .bthp-hss__foot{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,440px);gap:40px;align-items:end;opacity:0;transform:translate3d(0,16px,0);transition:opacity .4s ease,transform 0s linear .4s}
  .bthp-hss__slide.is-in .bthp-hss__foot{opacity:1;transform:none;transition:opacity 1s ease .6s,transform 1.1s cubic-bezier(.2,.7,.2,1) .6s}
  @media (min-width:750px){.bthp-hss__foot>div:last-child{grid-column:2}}
  .bthp-hss__lede{max-width:min(560px,var(--bthp-hw,50%));margin:calc(14px - clamp(28px,4vh,44px)) 0 clamp(24px,3.4vh,36px);font-family:var(--text-font-family,Poppins,sans-serif);font-size:17px;line-height:1.6;opacity:0;transform:translate3d(0,14px,0);transition:opacity .4s ease,transform 0s linear .4s}
  .bthp-hss__slide.is-in .bthp-hss__lede{opacity:.92;transform:none;transition:opacity 1s ease .5s,transform 1.1s cubic-bezier(.2,.7,.2,1) .5s}
  .bthp-hss__meta{display:flex;flex-wrap:wrap;gap:10px 28px;align-items:center}
  .bthp-hss__meta span{font-family:var(--text-font-family,Poppins,sans-serif);font-size:10px;font-weight:700;letter-spacing:.26em;text-transform:uppercase;opacity:.85}
  .bthp-hss__sub{margin:0 0 20px;font-family:var(--text-font-family,Poppins,sans-serif);font-size:15px;line-height:1.7;opacity:.92}
  .bthp-hss__ctas{display:flex;flex-wrap:wrap;gap:12px}
  .bthp-hss__btn{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:0 34px;box-sizing:border-box;border-radius:0;font-family:var(--text-font-family,Poppins,sans-serif);font-weight:700;font-size:12px;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;transition:background .3s ease,color .3s ease,box-shadow .3s ease}
  .bthp-hss__btn--a{background:var(--bthp-btn-bg);color:var(--bthp-btn-text)}
  .bthp-hss__btn--a:hover{background:var(--bthp-btn-text);color:var(--bthp-btn-bg)}
  .bthp-hss__btn--b{background:transparent;color:var(--bthp-text);box-shadow:inset 0 0 0 1px currentColor}
  .bthp-hss__btn--b:hover{background:var(--bthp-text);color:#1a1a1a}

  /* Controls: counter, one thin progress line per slide, arrows */
  .bthp-hss__bar{position:absolute;left:0;right:0;bottom:0;z-index:3;max-width:1440px;margin:0 auto;padding:0 clamp(20px,4.4vw,64px) clamp(28px,4vh,40px);box-sizing:border-box;display:flex;align-items:center;gap:24px;font-family:var(--text-font-family,Poppins,sans-serif);opacity:0;transition:opacity 1s ease}
  .bthp-hss.is-live .bthp-hss__bar{opacity:1}
  .bthp-hss__count{flex:none;font-size:10px;font-weight:700;letter-spacing:.26em;font-variant-numeric:tabular-nums;opacity:.85}
  .bthp-hss__lines{flex:1;display:flex;gap:8px;min-width:0}
  .bthp-hss__line{position:relative;flex:1;height:24px;padding:0;border:0;background:transparent;cursor:pointer}
  .bthp-hss__line::before,.bthp-hss__line i{content:"";position:absolute;left:0;right:0;top:50%;height:1px;margin-top:-.5px}
  .bthp-hss__line::before{background:rgba(255,255,255,.3)}
  .bthp-hss__line i{background:var(--bthp-text);transform:scaleX(0);transform-origin:0 50%}
  .bthp-hss__line.is-done i{transform:none}
  .bthp-hss__line.is-on i{animation:bthpHssA var(--bthp-dur,7s) linear forwards}
  .bthp-hss__line.is-on.is-odd i{animation-name:bthpHssB}
  .bthp-hss.is-hold .bthp-hss__line.is-on i,.bthp-hss.bthp-off .bthp-hss__line.is-on i{animation-play-state:paused}
  .bthp-hss.is-still .bthp-hss__line.is-on i{animation:none;transform:none}
  @keyframes bthpHssA{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  @keyframes bthpHssB{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  .bthp-hss__arw{flex:none;display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:0;border-radius:50%;background:transparent;color:var(--bthp-text);box-shadow:inset 0 0 0 1px rgba(255,255,255,.4);cursor:pointer;transition:box-shadow .3s ease,background .3s ease}
  .bthp-hss__arw:hover{box-shadow:inset 0 0 0 1px var(--bthp-text)}
  .bthp-hss__arws{flex:none;display:flex;gap:8px}
  .bthp-hss__line:focus-visible,.bthp-hss__arw:focus-visible{outline:1px solid var(--bthp-text);outline-offset:3px}

  /* Alignment */
  @media (min-width:750px){
    .bthp-hss[data-al="center"] .bthp-hss__h{text-align:center;margin-left:auto;margin-right:auto}
    .bthp-hss[data-al="right"] .bthp-hss__h{text-align:right;margin-left:auto}
    .bthp-hss[data-al="center"] .bthp-hss__lede{text-align:center;margin-left:auto;margin-right:auto}
    .bthp-hss[data-al="right"] .bthp-hss__lede{text-align:right;margin-left:auto}
    .bthp-hss[data-al="center"] .bthp-hss__foot,.bthp-hss[data-al="right"] .bthp-hss__foot{display:flex;flex-direction:column;gap:22px}
    .bthp-hss[data-al="center"] .bthp-hss__foot{align-items:center;text-align:center}
    .bthp-hss[data-al="right"] .bthp-hss__foot{align-items:flex-end;text-align:right}
    .bthp-hss[data-al="center"] .bthp-hss__foot>div:last-child,.bthp-hss[data-al="right"] .bthp-hss__foot>div:last-child{max-width:560px}
    .bthp-hss[data-al="center"] .bthp-hss__meta,.bthp-hss[data-al="right"] .bthp-hss__meta{order:2}
    .bthp-hss[data-al="center"] .bthp-hss__meta,.bthp-hss[data-al="center"] .bthp-hss__ctas{justify-content:center}
    .bthp-hss[data-al="right"] .bthp-hss__meta,.bthp-hss[data-al="right"] .bthp-hss__ctas{justify-content:flex-end}
  }

  /* Opening reveal (same as BT Hero + reveal) */
  .bthp-intro{position:fixed;inset:0;z-index:999;pointer-events:none}
  .bthp-hss.is-plain .bthp-intro{display:none}
  .bthp-intro__p{position:absolute;left:0;right:0;height:50.5%;background:var(--bthp-intro-bg);overflow:hidden;will-change:transform}
  .bthp-intro__p--t{top:0;animation:bthpIpT 3.6s cubic-bezier(.76,0,.24,1) forwards}
  .bthp-intro__p--b{bottom:0;animation:bthpIpB 3.6s cubic-bezier(.76,0,.24,1) forwards}
  @keyframes bthpIpT{0%,46%{transform:translate3d(0,0,0)}62%,72%{transform:translate3d(0,-26%,0)}100%{transform:translate3d(0,-101%,0)}}
  @keyframes bthpIpB{0%,46%{transform:translate3d(0,0,0)}62%,72%{transform:translate3d(0,26%,0)}100%{transform:translate3d(0,101%,0)}}
  .bthp-intro__m{position:absolute;left:50%;color:var(--bthp-intro-text)}
  .bthp-intro__p--t .bthp-intro__m{bottom:0;transform:translate(-50%,50%)}
  .bthp-intro__p--b .bthp-intro__m{top:0;transform:translate(-50%,-50%)}
  .bthp-intro__row{position:relative;display:flex;align-items:center;gap:clamp(14px,2.4vw,32px)}
  .bthp-intro__line{display:block;width:min(16vw,200px);height:1px;background:var(--bthp-sand);transform:scaleX(0);animation:bthpLine 1.2s cubic-bezier(.2,.7,.2,1) .2s forwards}
  .bthp-intro__line--l{transform-origin:100% 50%}
  .bthp-intro__line--r{transform-origin:0 50%}
  @keyframes bthpLine{to{transform:scaleX(1)}}
  .bthp-intro__word{display:flex;font-family:var(--heading-font-family,"Playfair Display",serif);font-weight:400;font-size:clamp(34px,5vw,72px);line-height:1;letter-spacing:.3em;margin-right:-.3em;white-space:nowrap}
  .bthp-intro__word span{display:inline-block;opacity:0;transform:translate3d(0,36%,0);animation:bthpL 1s cubic-bezier(.2,.7,.2,1) forwards}
  @keyframes bthpL{to{opacity:1;transform:none}}
  .bthp-intro__sub,.bthp-intro__sup{position:absolute;left:0;right:0;margin:0;text-align:center;font-family:var(--text-font-family,Poppins,sans-serif);font-size:9px;font-weight:700;text-transform:uppercase;opacity:0;animation:bthpS .9s ease forwards}
  .bthp-intro__sub{top:calc(100% + 22px);letter-spacing:.62em;margin-right:-.62em;color:var(--bthp-sand);animation-delay:1.2s}
  .bthp-intro__sup{bottom:calc(100% + 22px);letter-spacing:.5em;margin-right:-.5em;color:var(--bthp-intro-text);animation-delay:.9s}
  @keyframes bthpS{to{opacity:.75}}

  @media (max-width:749px){
    .bthp-hss{height:var(--bthp-hmv,92vh);height:var(--bthp-hm,92svh);min-height:340px}
    .bthp-hss__media .bthp-hss__d{display:none}
    .bthp-hss__media .bthp-hss__m{display:block}
    .bthp-hss__media img,.bthp-hss__media video,.bthp-hss__media svg{object-position:var(--pm,50% 50%)}
    .bthp-hss__in{padding:0 20px 76px}
    .bthp-hss__h{max-width:none;font-size:calc(48px * var(--bthp-hz, 1));margin-bottom:22px}
    .bthp-hss__lede{max-width:none;margin:-10px 0 18px;font-size:15px}
    .bthp-hss__foot{grid-template-columns:minmax(0,1fr);gap:16px}
    .bthp-hss__meta{gap:6px 16px}
    .bthp-hss__meta span{font-size:9px;letter-spacing:.2em}
    .bthp-hss[data-metam="false"] .bthp-hss__meta{display:none}
    .bthp-hss[data-subm="false"] .bthp-hss__sub{display:none}
    .bthp-hss[data-alm="center"] .bthp-hss__in{text-align:center}
    .bthp-hss[data-alm="right"] .bthp-hss__in{text-align:right}
    .bthp-hss[data-alm="center"] .bthp-hss__meta,.bthp-hss[data-alm="center"] .bthp-hss__ctas{justify-content:center}
    .bthp-hss[data-alm="right"] .bthp-hss__meta,.bthp-hss[data-alm="right"] .bthp-hss__ctas{justify-content:flex-end}
    .bthp-hss__sub{font-size:14px;margin-bottom:16px}
    .bthp-hss__ctas{flex-wrap:nowrap}
    .bthp-hss__btn{flex:1 1 0;padding:0 10px;min-height:50px;font-size:11px;letter-spacing:.14em}
    .bthp-hss__bar{padding:0 20px 22px;gap:14px}
    .bthp-hss__arws{display:none}
    .bthp-intro__line{width:12vw}
  }
  @media (prefers-reduced-motion:reduce){
    .bthp-intro{display:none}
    .bthp-hss__media,.bthp-hss__slide.is-on .bthp-hss__media{transform:none;transition:none}
    .bthp-hss__ln>span,.bthp-hss__foot,.bthp-hss__lede{transform:none;opacity:1;transition:none}
  }
</style>

<div
  class="bthp-hss{% if s.show_intro %} is-intro{% else %} is-plain{% endif %}"
  data-bthp-hss
  data-once="{{ s.intro_once }}"
  data-auto="{{ s.autoplay }}"
  data-secs="{{ s.speed }}"
  data-hover="{{ s.pause_hover }}"
  data-metam="{% if s.meta_mobile == false %}false{% else %}true{% endif %}"
  data-subm="{% if s.text_mobile == false %}false{% else %}true{% endif %}"
  data-parallax="{% if s.parallax == false %}false{% else %}true{% endif %}"
  data-zoom="{% if s.zoom == false %}false{% else %}true{% endif %}"
  data-al="{{ s.align }}"
  data-alm="{{ s.align_mobile }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ s.label | escape }}"
  {% if s.allow_transparent_header %}data-transparent allow-transparent-header{% endif %}
  style="--bthp-text: {{ s.text_color }}; --bthp-sand: {{ s.accent_color }}; --bthp-btn-bg: {{ s.button_bg }}; --bthp-btn-text: {{ s.button_text }}; --bthp-ov: {{ s.overlay | divided_by: 100.0 }}; --bthp-intro-bg: {{ s.intro_bg }}; --bthp-intro-text: {{ s.intro_text }};{% if s.height == 'large' %} --bthp-h: 86vh;{% endif %} --bthp-hw: {{ s.heading_width }}%; --bthp-hz-d: {{ s.heading_size | divided_by: 100.0 }}; --bthp-hz-m: {{ s.heading_size_mobile | divided_by: 100.0 }}; --bthp-dur: {{ s.speed }}s; --bthp-hm: {{ s.height_mobile | default: 92 }}svh; --bthp-hmv: {{ s.height_mobile | default: 92 }}vh;"
>
  {%- if s.show_intro -%}
    <div class="bthp-intro" aria-hidden="true">
      {%- for half in (1..2) -%}
        <div class="bthp-intro__p {% if half == 1 %}bthp-intro__p--t{% else %}bthp-intro__p--b{% endif %}">
          <div class="bthp-intro__m">
            <div class="bthp-intro__row">
              {%- if s.intro_top != blank -%}<p class="bthp-intro__sup">{{ s.intro_top }}</p>{%- endif -%}
              <span class="bthp-intro__line bthp-intro__line--l"></span>
              <span class="bthp-intro__word">
                {%- for l in letters -%}
                  {%- assign d = forloop.index0 | times: 0.09 | plus: 0.35 -%}
                  <span style="animation-delay: {{ d }}s;">{{ l }}</span>
                {%- endfor -%}
              </span>
              <span class="bthp-intro__line bthp-intro__line--r"></span>
              {%- if s.intro_bottom != blank -%}<p class="bthp-intro__sub">{{ s.intro_bottom }}</p>{%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="bthp-hss__track">
    {%- for block in slides -%}
      {%- liquid
        assign b = block.settings
        assign first = forloop.first
        assign img_d = b.image
        assign img_m = b.image_mobile | default: b.image
        assign pos_d = '50% 50%'
        if img_d.presentation.focal_point
          assign pos_d = img_d.presentation.focal_point
        endif
        assign pos_m = pos_d
        if img_m.presentation.focal_point
          assign pos_m = img_m.presentation.focal_point
        endif
        assign vid_d = b.video
        assign vid_m = b.video_mobile
        if vid_m == blank and b.image_mobile == blank
          assign vid_m = b.video
        endif
        assign src_attr = 'src'
        assign set_attr = 'srcset'
        unless first
          assign src_attr = 'data-src'
          assign set_attr = 'data-srcset'
        endunless
        assign htag = 'h2'
        if first
          assign htag = 'h1'
        endif
      -%}
      <div class="bthp-hss__slide{% if first %} is-on{% endif %}" data-slide="{{ forloop.index0 }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ n }}"{% unless first %} aria-hidden="true" inert{% endunless %} {{ block.shopify_attributes }}>
        <div class="bthp-hss__media" style="--pd: {{ pos_d }}; --pm: {{ pos_m }};">
          {%- if vid_d == blank and vid_m == blank -%}
            {%- comment -%} Photos: the first slide loads straight away; later slides wait until just before they show. {%- endcomment -%}
            {%- if img_d != blank -%}
              <picture>
                {%- if b.image_mobile != blank -%}
                  <source media="(max-width: 749px)" sizes="100vw" {{ set_attr }}="{{ img_m | image_url: width: 500 }} 500w, {{ img_m | image_url: width: 750 }} 750w, {{ img_m | image_url: width: 1000 }} 1000w, {{ img_m | image_url: width: 1400 }} 1400w">
                {%- endif -%}
                <img {{ src_attr }}="{{ img_d | image_url: width: 1500 }}" {{ set_attr }}="{{ img_d | image_url: width: 750 }} 750w, {{ img_d | image_url: width: 1100 }} 1100w, {{ img_d | image_url: width: 1500 }} 1500w, {{ img_d | image_url: width: 1900 }} 1900w, {{ img_d | image_url: width: 2400 }} 2400w" sizes="100vw" width="{{ img_d.width }}" height="{{ img_d.height }}" alt="{{ img_d.alt | escape }}" decoding="async"{% if first %} fetchpriority="high"{% endif %}>
              </picture>
            {%- elsif img_m != blank -%}
              <img {{ src_attr }}="{{ img_m | image_url: width: 1000 }}" {{ set_attr }}="{{ img_m | image_url: width: 500 }} 500w, {{ img_m | image_url: width: 1000 }} 1000w, {{ img_m | image_url: width: 1400 }} 1400w" sizes="100vw" width="{{ img_m.width }}" height="{{ img_m.height }}" alt="{{ img_m.alt | escape }}" decoding="async"{% if first %} fetchpriority="high"{% endif %}>
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {%- endif -%}
          {%- else -%}
            {%- comment -%} Video: nothing downloads until its slide plays. {%- endcomment -%}
            {%- if vid_d != blank -%}
              {{ vid_d | video_tag: autoplay: false, preload: 'none', loop: true, muted: true, controls: false, playsinline: true, class: 'bthp-hss__d bthp-hss__v', image_size: '2000x' }}
            {%- elsif img_d != blank -%}
              <img class="bthp-hss__d" {{ src_attr }}="{{ img_d | image_url: width: 1500 }}" {{ set_attr }}="{{ img_d | image_url: width: 1100 }} 1100w, {{ img_d | image_url: width: 1500 }} 1500w, {{ img_d | image_url: width: 2400 }} 2400w" sizes="100vw" width="{{ img_d.width }}" height="{{ img_d.height }}" alt="{{ img_d.alt | escape }}" decoding="async">
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'bthp-hss__d' }}
            {%- endif -%}
            {%- if vid_m != blank -%}
              {{ vid_m | video_tag: autoplay: false, preload: 'none', loop: true, muted: true, controls: false, playsinline: true, class: 'bthp-hss__m bthp-hss__v', image_size: '900x' }}
            {%- elsif img_m != blank -%}
              <img class="bthp-hss__m" {{ src_attr }}="{{ img_m | image_url: width: 1000 }}" {{ set_attr }}="{{ img_m | image_url: width: 500 }} 500w, {{ img_m | image_url: width: 1000 }} 1000w, {{ img_m | image_url: width: 1400 }} 1400w" sizes="100vw" width="{{ img_m.width }}" height="{{ img_m.height }}" alt="{{ img_m.alt | escape }}" decoding="async">
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'bthp-hss__m' }}
            {%- endif -%}
          {%- endif -%}
        </div>
        <div class="bthp-hss__shade"></div>
        <div class="bthp-hss__in">
          <{{ htag }} class="bthp-hss__h">
            <span class="bthp-hss__ln"><span>{{ b.heading_1 }}</span></span>
            {%- if b.heading_2 != blank -%}
              <span class="bthp-hss__ln"><span class="bthp-hss__gilt">{{ b.heading_2 }}</span></span>
            {%- endif -%}
          </{{ htag }}>
          {%- if b.subheading != blank -%}<p class="bthp-hss__lede">{{ b.subheading | newline_to_br }}</p>{%- endif -%}
          <div class="bthp-hss__foot">
            {%- if b.meta_1 != blank or b.meta_2 != blank or b.meta_3 != blank -%}
<div class="bthp-hss__meta">
              {%- if b.meta_1 != blank -%}<span>{{ b.meta_1 }}</span>{%- endif -%}
              {%- if b.meta_2 != blank -%}<span>{{ b.meta_2 }}</span>{%- endif -%}
              {%- if b.meta_3 != blank -%}<span>{{ b.meta_3 }}</span>{%- endif -%}
            </div>
{%- endif -%}
            <div>
              {%- if b.text != blank -%}<p class="bthp-hss__sub">{{ b.text }}</p>{%- endif -%}
              <div class="bthp-hss__ctas">
                {%- if b.button_1_label != blank -%}
                  <a class="bthp-hss__btn bthp-hss__btn--a" href="{{ b.button_1_link | default: '#buy' }}">{{ b.button_1_label }}</a>
                {%- endif -%}
                {%- if b.button_2_label != blank -%}
                  <a class="bthp-hss__btn bthp-hss__btn--b" href="{{ b.button_2_link | default: '#stages' }}">{{ b.button_2_label }}</a>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if n > 1 -%}
    <div class="bthp-hss__bar">
      {%- if s.show_counter -%}<span class="bthp-hss__count" aria-hidden="true"><span data-cur>01</span> / {% if n < 10 %}0{% endif %}{{ n }}</span>{%- endif -%}
      <div class="bthp-hss__lines">
        {%- for block in slides -%}
          <button class="bthp-hss__line{% if forloop.first %} is-on{% endif %}" type="button" data-go="{{ forloop.index0 }}" aria-label="Show slide {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}><i></i></button>
        {%- endfor -%}
      </div>
      {%- if s.show_arrows -%}
        <div class="bthp-hss__arws">
          <button class="bthp-hss__arw" type="button" data-prev aria-label="Previous slide"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
          <button class="bthp-hss__arw" type="button" data-next aria-label="Next slide"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg></button>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var roots = document.querySelectorAll('[data-bthp-hss]:not([data-ready])');
    roots.forEach(function (el) {
      el.setAttribute('data-ready', '');
      var KEY = 'bthp-intro-seen';
      var skip = false;
      try { if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) skip = true; } catch (e) {}
      if (el.getAttribute('data-once') === 'true' && !(window.Shopify && window.Shopify.designMode)) {
        try { if (sessionStorage.getItem(KEY)) skip = true; else sessionStorage.setItem(KEY, '1'); } catch (e) {}
      }
      if (!el.querySelector('.bthp-intro')) skip = true;
      if (skip) { el.classList.remove('is-intro'); el.classList.add('is-plain'); }
      var intro = el.querySelector('.bthp-intro');
      if (intro && !skip) setTimeout(function () { intro.remove(); }, 3800); else if (intro) intro.remove();

      var slides = [].slice.call(el.querySelectorAll('[data-slide]'));
      var lines = [].slice.call(el.querySelectorAll('[data-go]'));
      var curEl = el.querySelector('[data-cur]');
      var n = slides.length, cur = 0, timer = 0, live = false, seen = true, hold = false, edit = !!(window.Shopify && window.Shopify.designMode);
      var secs = Math.max(3, parseFloat(el.getAttribute('data-secs')) || 7);
      var auto = el.getAttribute('data-auto') === 'true' && n > 1;
      if (!auto) el.classList.add('is-still');

      // Give a slide its real photo just before it is needed (the next slide is primed while the current one plays).
      function prime(i) {
        var sl = slides[(i + n) % n];
        if (!sl || sl._primed) return;
        sl._primed = true;
        sl.querySelectorAll('[data-srcset]').forEach(function (x) { x.setAttribute('srcset', x.getAttribute('data-srcset')); x.removeAttribute('data-srcset'); });
        sl.querySelectorAll('[data-src]').forEach(function (x) { x.setAttribute('src', x.getAttribute('data-src')); x.removeAttribute('data-src'); });
      }
      // Only the slide on screen may play its video.
      function videos() {
        slides.forEach(function (sl, i) {
          sl.querySelectorAll('video.bthp-hss__v').forEach(function (v) {
            if (i === cur && seen && v.offsetParent !== null) {
              if (v.getAttribute('preload') === 'none') v.setAttribute('preload', 'auto');
              v.muted = true;
              var pr = v.play(); if (pr && pr.catch) pr.catch(function () {});
            } else if (!v.paused) v.pause();
          });
        });
      }
      function arm() {
        clearTimeout(timer);
        if (auto && live && seen && !hold && !document.hidden) timer = setTimeout(function () { go(cur + 1); }, secs * 1000);
      }
      function restartLine() {
        lines.forEach(function (l, i) {
          l.classList.remove('is-on', 'is-odd');
          l.classList.toggle('is-done', i < cur);
          if (i === cur) { l.setAttribute('aria-current', 'true'); } else l.removeAttribute('aria-current');
        });
        var l = lines[cur];
        if (l) { void l.offsetWidth; l.classList.add('is-on'); if (cur % 2) l.classList.add('is-odd'); }
      }
      // Fade only once the next photo is decoded (at most ~0.7s wait), so it never fades into a blank.
      function ready(sl, cb) {
        var im = [].filter.call(sl.querySelectorAll('img'), function (x) { return x.offsetParent !== null || x.closest('picture'); })[0];
        if (!im || !im.decode || (im.complete && im.naturalWidth)) { cb(); return; }
        var done = false, fin = function () { if (!done) { done = true; cb(); } };
        im.decode().then(fin, fin); setTimeout(fin, 700);
      }
      var want = -1;
      function go(i) {
        if (n < 2) return;
        i = (i + n) % n;
        prime(i);
        want = i;
        ready(slides[i], function () { if (want === i) show(i); });
      }
      function show(i) {
        var prev = slides[cur], next = slides[i];
        cur = i;
        if (prev !== next) {
          prev.classList.remove('is-on', 'is-in');
          prev.setAttribute('aria-hidden', 'true'); prev.setAttribute('inert', '');
        }
        next.removeAttribute('aria-hidden'); next.removeAttribute('inert');
        next.classList.add('is-on');
        void next.offsetWidth;
        next.classList.add('is-in');
        if (curEl) curEl.textContent = (i + 1 < 10 ? '0' : '') + (i + 1);
        restartLine();
        videos();
        prime(i + 1);
        arm();
      }
      function begin() {
        live = true;
        el.classList.add('is-live');
        slides[0].classList.add('is-in');
        restartLine();
        videos();
        if (n > 1) setTimeout(function () { prime(1); }, 1200);
        arm();
      }
      setTimeout(begin, skip ? 60 : 2900);

      lines.forEach(function (l, i) { l.addEventListener('click', function () { go(i); }); });
      var pv = el.querySelector('[data-prev]'), nx = el.querySelector('[data-next]');
      if (pv) pv.addEventListener('click', function () { go(cur - 1); });
      if (nx) nx.addEventListener('click', function () { go(cur + 1); });
      // Swipe on phones
      var sx = 0, sy = 0;
      el.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
      el.addEventListener('touchend', function (e) {
        var t = e.changedTouches[0], dx = t.clientX - sx, dy = t.clientY - sy;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.4) go(cur + (dx < 0 ? 1 : -1));
      }, { passive: true });
      // Pause while the mouse is on the text, buttons or controls (if set), off screen, or with the tab hidden.
      // (Not the whole hero: it fills the screen, so the mouse is almost always somewhere on it.)
      if (el.getAttribute('data-hover') === 'true') {
        el.querySelectorAll('.bthp-hss__foot, .bthp-hss__h, .bthp-hss__bar').forEach(function (z) {
          z.addEventListener('pointerenter', function (e) { if (e.pointerType !== 'mouse') return; hold = true; el.classList.add('is-hold'); clearTimeout(timer); });
          z.addEventListener('pointerleave', function (e) { if (e.pointerType !== 'mouse' || !hold) return; hold = false; el.classList.remove('is-hold'); if (live) restartLine(); arm(); });
        });
      }
      document.addEventListener('visibilitychange', function () { if (document.hidden) clearTimeout(timer); else if (live) { restartLine(); arm(); } });
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (en) {
          var was = seen; seen = en[0].isIntersecting;
          el.classList.toggle('bthp-off', !seen);
          if (seen && !was && live) restartLine();
          videos(); arm();
        }, { rootMargin: '150px 0px' }).observe(el);
      }
      // Theme editor: clicking a slide block shows that slide and holds it.
      if (edit) {
        document.addEventListener('shopify:block:select', function (e) {
          var k = slides.indexOf(e.target); if (k < 0) return;
          hold = true; clearTimeout(timer); go(k); clearTimeout(timer);
        });
        document.addEventListener('shopify:block:deselect', function () { hold = false; arm(); });
      }

      // Scroll effect (computer only): moves the slides and fades the text directly; no work on phones.
      var track = el.querySelector('.bthp-hss__track');
      var bar = el.querySelector('.bthp-hss__bar');
      var mq = window.matchMedia('(min-width: 750px) and (hover: hover)');
      var top = 0, hgt = 1, last = -1, raf = 0, near = true, on = false;
      var allTexts = [].slice.call(el.querySelectorAll('.bthp-hss__in'));
      function texts() { return allTexts.filter(function (x) { return x.parentNode.classList.contains('is-on'); }); }
      function measure() { var r = el.getBoundingClientRect(); top = r.top + window.pageYOffset; hgt = Math.max(r.height, 1); }
      function paint() {
        raf = 0;
        if (!on) return;
        var y = Math.max(0, Math.min(1, (window.pageYOffset - top) / hgt));
        y = Math.round(y * 500) / 500;
        if (y === last) return;
        last = y;
        track.style.transform = y ? 'translate3d(0,' + (y * 16).toFixed(2) + '%,0) scale(' + (1 + y * .06).toFixed(4) + ')' : '';
        var o = y ? Math.max(0, 1 - y * 1.6).toFixed(3) : '', t = y ? 'translate3d(0,' + (y * -70).toFixed(1) + 'px,0)' : '';
        texts().forEach(function (x) { x.style.opacity = o; x.style.transform = t; });
        if (bar) bar.style.opacity = o;
      }
      function clear() {
        last = -1; track.style.transform = '';
        el.querySelectorAll('.bthp-hss__in').forEach(function (x) { x.style.opacity = ''; x.style.transform = ''; });
        if (bar) bar.style.opacity = '';
      }
      function onScroll() { if (on && near && !raf) raf = requestAnimationFrame(paint); }
      function setup() {
        var want = el.getAttribute('data-parallax') !== 'false' && mq.matches && !!track;
        if (want === on) { if (on) { measure(); onScroll(); } return; }
        on = want;
        el.classList.toggle('is-px', on);
        if (on) { measure(); window.addEventListener('scroll', onScroll, { passive: true }); paint(); }
        else { window.removeEventListener('scroll', onScroll); clear(); }
      }
      if ('IntersectionObserver' in window) new IntersectionObserver(function (en) { near = en[0].isIntersecting; if (near) onScroll(); }).observe(el);
      var rt = 0;
      window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(function () { setup(); videos(); }, 150); }, { passive: true });
      setup();
    });
  })();
</script>

{% schema %}
{
  "name": "BT Hero slideshow",
  "class": "bthp-section",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Opening reveal" },
    { "type": "checkbox", "id": "show_intro", "label": "Play the opening reveal", "default": true },
    { "type": "checkbox", "id": "intro_once", "label": "Only on a visitor's first page view", "info": "Plays once per visit. In the theme editor it always plays.", "default": true },
    { "type": "text", "id": "intro_word", "label": "Wordmark", "default": "BENTLEY" },
    { "type": "text", "id": "intro_top", "label": "Line above wordmark", "default": "Officially licensed by Bentley Motors" },
    { "type": "text", "id": "intro_bottom", "label": "Line below wordmark", "default": "Trike" },
    { "type": "header", "content": "Slideshow" },
    { "type": "checkbox", "id": "autoplay", "label": "Move through slides by itself", "default": true },
    { "type": "range", "id": "speed", "label": "Time on each slide", "min": 4, "max": 12, "step": 1, "unit": "s", "default": 7 },
    { "type": "checkbox", "id": "pause_hover", "label": "Pause while the mouse is on the text or controls", "default": true },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows (computer)", "default": true, "info": "On phones, people swipe or tap the lines." },
    { "type": "checkbox", "id": "show_counter", "label": "Show slide number (01 / 03)", "default": true },
    { "type": "text", "id": "label", "label": "Slideshow name (screen readers)", "default": "Bentley Trike highlights" },
    { "type": "header", "content": "Look" },
    { "type": "range", "id": "overlay", "label": "Darken images", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 10 },
    { "type": "select", "id": "height", "label": "Height (desktop)", "options": [{ "value": "full", "label": "Full screen" }, { "value": "large", "label": "Large" }], "default": "full" },
    { "type": "range", "id": "height_mobile", "label": "Height (phone)", "min": 40, "max": 100, "step": 2, "unit": "%", "default": 92, "info": "Share of the phone screen the slideshow fills. Lower it if the slides feel too tall; use Heading size (phone) to fit the text." },
    { "type": "checkbox", "id": "allow_transparent_header", "label": "Allow transparent header", "info": "Only applies when this section is first on the page.", "default": true },
    { "type": "checkbox", "id": "zoom", "label": "Slow zoom on each photo", "default": true, "info": "Computer only; phones keep the photo still." },
    { "type": "checkbox", "id": "parallax", "label": "Parallax effect", "default": true, "info": "The slides drift and the text fades as you scroll down. Computer only; phones always stay still." },
    { "type": "header", "content": "Text position" },
    { "type": "select", "id": "align", "label": "Text position (desktop)", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "heading_width", "label": "Heading width (desktop)", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 50, "info": "How much of the screen width the heading can use before it wraps." },
    { "type": "select", "id": "align_mobile", "label": "Text position (phone)", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "checkbox", "id": "meta_mobile", "label": "Show small details on phone", "default": true },
    { "type": "checkbox", "id": "text_mobile", "label": "Show description on phone", "default": true, "info": "Turn off to keep shorter phone slides uncluttered." },
    { "type": "header", "content": "Heading size" },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (phone)", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent (sand)", "default": "#d9d0c5" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#ffffff" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#1a1a1a" },
    { "type": "color", "id": "intro_bg", "label": "Reveal background", "default": "#1a1a1a" },
    { "type": "color", "id": "intro_text", "label": "Reveal wordmark", "default": "#f8f4ef" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (desktop)", "info": "Landscape, at least 2400px wide. Set a focal point in the image settings." },
        { "type": "image_picker", "id": "image_mobile", "label": "Image (phone)", "info": "Portrait works best. Leave empty to use the desktop image." },
        { "type": "video", "id": "video", "label": "Video (desktop, optional)", "info": "Plays muted on a loop instead of the image, only while this slide shows." },
        { "type": "video", "id": "video_mobile", "label": "Video (phone, optional)" },
        { "type": "text", "id": "heading_1", "label": "Heading line 1", "default": "Extraordinary journeys" },
        { "type": "text", "id": "heading_2", "label": "Heading line 2 (italic)", "default": "start young." },
        { "type": "textarea", "id": "subheading", "label": "Text under heading", "info": "Optional. Sits between the heading and the details row." },
        { "type": "text", "id": "meta_1", "label": "Small detail 1", "default": "The Bentley 6-in-1 Stroller Trike" },
        { "type": "text", "id": "meta_2", "label": "Small detail 2", "default": "Officially licensed by Bentley Motors" },
        { "type": "text", "id": "meta_3", "label": "Small detail 3", "default": "From 6 months" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "A stroller you steer today, a trike that's entirely theirs tomorrow — finished in the colours of the cars from Crewe." },
        { "type": "text", "id": "button_1_label", "label": "Button 1 label", "default": "Shop the Trike" },
        { "type": "url", "id": "button_1_link", "label": "Button 1 link", "info": "Leave empty to scroll to the Trike buy box." },
        { "type": "text", "id": "button_2_label", "label": "Button 2 label", "default": "See how it grows" },
        { "type": "url", "id": "button_2_link", "label": "Button 2 link", "info": "Leave empty to scroll to the growth stages." }
      ]
    }
  ],
  "presets": [
    {
      "name": "BT Hero slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide", "settings": { "heading_1": "Hand-finished,", "heading_2": "the Mulliner way.", "meta_1": "Mulliner editions", "meta_2": "Quilted leather-look seat", "meta_3": "Limited colours", "text": "Diamond quilting, hand-painted coachlines and colours drawn from Bentley's Mulliner studio.", "button_1_label": "Shop Mulliner", "button_2_label": "" } },
        { "type": "slide", "settings": { "heading_1": "Folds in one move,", "heading_2": "goes everywhere.", "meta_1": "The Folding Trike", "meta_2": "Travel-ready", "meta_3": "From 10 months", "text": "Collapses flat with one hand, small enough for the boot or an overhead locker.", "button_1_label": "Shop Folding", "button_2_label": "" } }
      ]
    }
  ]
}
{% endschema %}