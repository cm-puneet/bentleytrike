                (data.products || []).forEach(function (p) {
                  if (skip[String(p.id)]) return;
                  if (!fromList && notExtra.test(p.title || '')) return;
                  var v = (p.variants || []).filter(function (x) {
                    return x.available;
                  })[0];
                  if (!v) return;
                  var img = (v.featured_image && v.featured_image.src) || p.featured_image || '';
                  if (img && img.indexOf('//') === 0) img = 'https:' + img;
                  var card = document.createElement('div');
                  card.className = 'bt-ebf__ex';
                  var pic = document.createElement('span');
