{{ 'bt-foldable.css' | asset_url | stylesheet_tag }}
{%- render 'btf-style', s: section -%}
<script src="{{ 'bt-foldable.js' | asset_url }}" defer></script>

<div class="btf btf-stats">
  <btf-autoscroll class="container" data-interval="{{ section.settings.interval }}">
    {%- for block in section.blocks -%}
      <div class="btf-stat" {{ block.shopify_attributes }}>
        <span class="h2">{{ block.settings.big | escape }}</span>
        <span>{{ block.settings.small | escape }}</span>
      </div>
    {%- endfor -%}
  </btf-autoscroll>
</div>

{% schema %}
{
  "name": "BT: stat bar",
  "settings": [
    { "type": "range", "id": "interval", "label": "Mobile: seconds per stat", "min": 2, "max": 8, "step": 1, "unit": "s", "default": 3 },
    {"type": "header", "content": "Colors", "info": "Leave a color empty to use the theme color."},
    {"type": "color", "id": "c_bg", "label": "Background", "default": "#00221c"},
    {"type": "color", "id": "c_heading", "label": "Headings", "default": "#ffffff"},
    {"type": "color", "id": "c_text", "label": "Text", "default": "#ffffff"},
    {"type": "header", "content": "Typography"},
    {"type": "select", "id": "t_heading_font", "label": "Heading font", "options": [{"value": "heading", "label": "Theme heading font"}, {"value": "body", "label": "Theme body font"}], "default": "heading"},
    {"type": "range", "id": "t_heading_scale", "label": "Heading size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100},
    {"type": "range", "id": "t_text_scale", "label": "Text size", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100}
  ],
  "blocks": [
    {
      "type": "stat", "name": "Stat", "limit": 4,
      "settings": [
        { "type": "text", "id": "big", "label": "Figure", "default": "4.9★" },
        { "type": "text", "id": "small", "label": "Caption", "default": "from parent reviews" }
      ]
    }
  ],
  "presets": [{ "name": "BT: stat bar" }]
}
{% endschema %}
