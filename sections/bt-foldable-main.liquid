{%- comment -%}
  Foldable Trike PDP: stacked gallery + sticky buy box with finish links (one product per finish) and sets (trike + add-ons).
  Set prices shown here are display only: the matching automatic discounts must exist in Shopify admin.
{%- endcomment -%}
{{ 'bt-foldable.css' | asset_url | stylesheet_tag }}
{%- render 'btf-style', s: section -%}
<script src="{{ 'bt-foldable.js' | asset_url }}" defer></script>

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign finish_name = product.title
  unless product.has_only_default_variant
    assign finish_name = variant.title
  endunless
  for block in section.blocks
    if block.type == 'finish' and block.settings.product.id == product.id and block.settings.label != blank
      assign finish_name = block.settings.label
    endif
  endfor

  assign base_price = variant.price
  assign base_was = variant.compare_at_price | default: 0 | at_least: variant.price
  assign max_pct = 0
  for block in section.blocks
    if block.type == 'set' and block.settings.discount > max_pct
      assign max_pct = block.settings.discount
    endif
  endfor
  assign first_set_done = false
  assign theme_pos = section.settings.theme_blocks_position
  assign has_theme_blocks = false
  for block in section.blocks
    unless block.type == 'bullet' or block.type == 'finish' or block.type == 'set' or block.type == 'trust'
      assign has_theme_blocks = true
    endunless
  endfor
-%}
{%- capture product_form_id -%}product-form-{{ product.id }}-{{ section.id }}{%- endcapture -%}
{%- if has_theme_blocks -%}
  {%- comment -%} The theme's own product blocks (text, description, collapsible tabs, app blocks...), rendered by its product-info snippet and linked to this section's form. {%- endcomment -%}
  {%- capture theme_blocks -%}
    {%- render 'product-info', product: product, product_form_id: product_form_id, context: 'main_product', main_form_exists: true -%}
  {%- endcapture -%}
  {%- assign theme_blocks = theme_blocks | replace: '<safe-sticky class="product-info">', '<div class="product-info btf-theme-blocks">' | replace: '</safe-sticky>', '</div>' -%}
{%- endif -%}

<div class="btf btf-atf" style="--ratio: {% if section.settings.crop_images %}3 / 4; --ratio-wide: 3 / 2{% else %}auto{% endif %}{% if section.settings.main_bg != blank %}; --btf-main-bg: {{ section.settings.main_bg }}{% endif %}">
  {%- comment -%} Slide 1 is the product's main image (the finish); slides 2-5 are the lifestyle shots from the design. {%- endcomment -%}
  {%- liquid
    assign slides = ''
    assign thumbs = ''
    assign count = 0
    assign wide = '400,600,800,1000,1200,1500,1800'
    assign first = product.featured_media.preview_image
  -%}
  {%- capture slide -%}
    <div class="btf-gallery__item btf-gallery__item--main">
      {%- liquid
        assign label = section.settings.first_label
        assign alt = product.featured_media.alt
        if alt contains '|'
          assign label = alt | split: '|' | first | strip
          assign alt = alt | split: '|' | last | strip
        endif
        assign alt = alt | default: product.title
      -%}
      {%- if first -%}
        {%- render 'btf-image', image: first, widths: wide, sizes: '(min-width: 1040px) 50vw, 82vw', loading: 'eager', priority: 'high', alt: alt -%}
      {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'btf-placeholder' }}{%- endif -%}
      {%- if section.settings.show_labels and label != blank -%}<span class="btf-tag">{{ label | escape }}</span>{%- endif -%}
    </div>
  {%- endcapture -%}
  {%- capture thumb -%}{%- if first -%}{%- render 'btf-image', image: first, widths: '80,160', sizes: '64px', alt: '' -%}{%- endif -%}{%- endcapture -%}
  {%- assign slides = slides | append: slide -%}
  {%- assign thumbs = thumbs | append: '<button type="button" class="btf-thumb" data-index="0" aria-current="true" aria-label="1">' | append: thumb | append: '</button>' -%}
  {%- assign count = 1 -%}
  {%- liquid
    assign use_product_media = false
    case section.settings.gallery_source
      when 'product'
        assign use_product_media = true
      when 'auto'
        if product.media.size > 1
          assign use_product_media = true
        endif
    endcase
  -%}
  {%- for i in (1..4) -%}
    {%- liquid
      if use_product_media
        break
      endif
      assign key = 'gallery_' | append: i
      assign img = section.settings[key]
      assign asset_key = key | append: '_asset'
      assign label_key = key | append: '_label'
      assign asset = section.settings[asset_key]
      assign label = section.settings[label_key]
      if img == blank and asset == blank
        continue
      endif
    -%}
    {%- capture slide -%}
      <div class="btf-gallery__item">
        {%- assign alt = label | default: product.title -%}
        {%- render 'btf-image', image: img, asset: asset, widths: wide, sizes: '(min-width: 1040px) 25vw, 82vw', loading: 'lazy', alt: alt -%}
        {%- if section.settings.show_labels and label != blank -%}<span class="btf-tag">{{ label | escape }}</span>{%- endif -%}
      </div>
    {%- endcapture -%}
    {%- capture thumb -%}<button type="button" class="btf-thumb" data-index="{{ count }}" aria-label="{{ count | plus: 1 }}">{%- render 'btf-image', image: img, asset: asset, widths: '80,160', sizes: '64px', alt: '' -%}</button>{%- endcapture -%}
    {%- assign slides = slides | append: slide -%}
    {%- assign thumbs = thumbs | append: thumb -%}
    {%- assign count = count | plus: 1 -%}
  {%- endfor -%}
  {%- if count == 1 -%}
    {%- comment -%} Product images (or no lifestyle images set). Alt text "LABEL | description" puts LABEL on the image; alt text without "|" shows no label. {%- endcomment -%}
    {%- for media in product.media offset: 1 limit: section.settings.media_limit -%}
      {%- liquid
        assign label = ''
        assign alt = media.alt
        if alt contains '|'
          assign label = alt | split: '|' | first | strip
          assign alt = alt | split: '|' | last | strip
        endif
        assign alt = alt | default: product.title
      -%}
      {%- capture slide -%}
        <div class="btf-gallery__item">
          {%- case media.media_type -%}
            {%- when 'video' -%}
              {{- media | video_tag: controls: true, muted: true, playsinline: true, preload: 'none', image_size: '1000x', class: 'btf-gallery__video' -}}
            {%- when 'external_video' -%}
              <div class="btf-gallery__video">{{- media | external_video_tag: loading: 'lazy' -}}</div>
            {%- else -%}
              {%- render 'btf-image', image: media.preview_image, widths: wide, sizes: '(min-width: 1040px) 25vw, 82vw', loading: 'lazy', alt: alt -%}
          {%- endcase -%}
          {%- if section.settings.show_labels and label != blank -%}<span class="btf-tag">{{ label | escape }}</span>{%- endif -%}
        </div>
      {%- endcapture -%}
      {%- capture thumb -%}<button type="button" class="btf-thumb" data-index="{{ count }}" aria-label="{{ count | plus: 1 }}">{%- render 'btf-image', image: media.preview_image, widths: '80,160', sizes: '64px', alt: '' -%}</button>{%- endcapture -%}
      {%- assign slides = slides | append: slide -%}
      {%- assign thumbs = thumbs | append: thumb -%}
      {%- assign count = count | plus: 1 -%}
    {%- endfor -%}
  {%- endif -%}
  {%- comment -%}
    Badges, eyebrow and Okendo star rating share one row, so the stars add no height.
    Okendo resolves product groups itself, so grouped (shared) reviews show here too.
  {%- endcomment -%}
  {%- capture intro_stars -%}
    {%- if section.settings.show_stars -%}
      <a class="btf-stars" href="#{{ section.settings.stars_anchor | default: 'reviews' }}" aria-label="{{ section.settings.stars_label | escape }}">
        <div data-oke-star-rating data-oke-reviews-product-id="shopify-{{ product.id }}"></div>
      </a>
    {%- endif -%}
  {%- endcapture -%}
  {%- capture intro_badges -%}
    <div class="btf-buy__badges">
      {%- if section.settings.badge != blank -%}<span class="badge">{{ section.settings.badge | escape }}</span>{%- endif -%}
      {%- if section.settings.eyebrow != blank -%}<span class="text-xs bold btf-buy__eyebrow" style="letter-spacing: .14em">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      [stars]
    </div>
  {%- endcapture -%}
  {%- comment -%}
    Mobile: the badges and title sit above the gallery (the buy box copy is hidden there).
    The badges fill the row on phones, so the stars go at the end of the title's last line instead.
  {%- endcomment -%}
  <div class="btf-buy__intro btf-intro--mobile">
    {{ intro_badges | replace: '[stars]', '' }}
    <div class="btf-intro__title"><p class="{{ section.settings.title_size }}" role="heading" aria-level="1">{{ product.title | escape }}</p> {{ intro_stars }}</div>
  </div>
  <btf-gallery class="btf-gallery-wrap">
    <div class="btf-gallery" aria-label="{{ product.title | escape }}">{{ slides }}</div>
    {%- if count > 1 -%}<div class="btf-thumbs">{{ thumbs }}</div>{%- endif -%}
  </btf-gallery>

  <btf-buy-box class="btf-buy" id="bt-buy">
    <div class="btf-buy__intro btf-intro--desktop">
      {{ intro_badges | replace: '[stars]', intro_stars }}
      <h1 class="{{ section.settings.title_size }}">{{ product.title | escape }}</h1>
    </div>
    {%- if theme_pos == 'after_title' -%}{{ theme_blocks }}{%- endif -%}

    {%- capture bullets -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'bullet' and block.settings.text != blank -%}
          <li {{ block.shopify_attributes }}>{%- render 'icon' with 'success', width: 16, height: 16 -%}<span>{{ block.settings.text | escape }}</span></li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if bullets != blank -%}<ul class="btf-bullets text-sm">{{ bullets }}</ul>{%- endif -%}
    {%- if theme_pos == 'after_bullets' -%}{{ theme_blocks }}{%- endif -%}

    {%- capture finishes -%}
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if block.type == 'finish' and p != blank -%}
          {%- assign thumb = block.settings.image | default: p.featured_media.preview_image -%}
          {%- assign swatch_asset = block.settings.asset -%}
          {%- if block.settings.image != blank -%}{%- assign swatch_asset = '' -%}{%- endif -%}
          <a class="btf-finish" href="{{ p.url }}" {% if p.id == product.id %}aria-current="true"{% endif %} title="{{ block.settings.label | default: p.title | escape }}" {{ block.shopify_attributes }}>
            {%- if swatch_asset != blank -%}
              {%- render 'btf-image', asset: swatch_asset, widths: '150,300', sizes: '(min-width: 1040px) 130px, 22vw', alt: '' -%}
            {%- elsif thumb -%}
              {%- render 'btf-image', image: thumb, widths: '150,300', sizes: '(min-width: 1040px) 130px, 22vw', alt: '' -%}
            {%- else -%}<span class="btf-placeholder"></span>{%- endif -%}
            <span>{{ block.settings.label | default: p.title | escape }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if finishes == blank and product.has_only_default_variant == false -%}
      {%- comment -%} No finish products picked: the product's own variants become the finish tiles. {%- endcomment -%}
      {%- capture finishes -%}
        {%- for v in product.variants -%}
          {%- assign thumb = v.featured_image | default: product.featured_media.preview_image -%}
          <a class="btf-finish" href="{{ v.url }}" data-variant-link {% if v.id == variant.id %}aria-current="true"{% endif %} {% unless v.available %}aria-disabled="true"{% endunless %} title="{{ v.title | escape }}">
            {%- if thumb -%}
              {%- render 'btf-image', image: thumb, widths: '150,300', sizes: '(min-width: 1040px) 130px, 22vw', alt: '' -%}
            {%- else -%}<span class="btf-placeholder"></span>{%- endif -%}
            <span>{{ v.title | escape }}</span>
          </a>
        {%- endfor -%}
      {%- endcapture -%}
    {%- endif -%}
    {%- if finishes != blank -%}
      <div class="btf-step" id="choose-finish">
        {%- assign finish_count = finishes | split: 'class="btf-finish"' | size | minus: 1 -%}
        <div class="btf-step__label"><span>{{ section.settings.finish_heading | escape }}</span><span>{{ finish_name | escape }}</span></div>
        {%- if finish_count > 5 -%}
          <btf-finish-rail class="btf-finish-rail">
            <button type="button" class="btf-arrow btf-arrow--sm" data-step="-1" aria-label="Previous finishes" disabled>{%- render 'icon' with 'chevron-left', width: 7, height: 11 -%}</button>
            <div class="btf-finishes btf-finishes--rail">{{ finishes }}</div>
            <button type="button" class="btf-arrow btf-arrow--sm" data-step="1" aria-label="More finishes">{%- render 'icon' with 'chevron-right', width: 7, height: 11 -%}</button>
          </btf-finish-rail>
        {%- else -%}
          <div class="btf-finishes">{{ finishes }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}


    {%- if theme_pos == 'after_finish' -%}
      {%- comment -%} Optional step heading over the theme blocks (e.g. "2. CHOOSE YOUR OFFER" over an offer widget). {%- endcomment -%}
      {%- if section.settings.theme_blocks_heading != blank and theme_blocks != blank -%}
        <div class="btf-step btf-step--blocks"><div class="btf-step__label"><span>{{ section.settings.theme_blocks_heading | escape }}</span></div>{{ theme_blocks }}</div>
      {%- else -%}
        {{ theme_blocks }}
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Same wrapper and button markup as the theme's buy buttons, so the Globo pre-order app finds the form and button. {%- endcomment -%}
    <div class="product-info__buy-buttons">
    {%- form 'product', product, id: product_form_id, novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ variant.id }}">

      {%- capture sets -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'set' -%}
            {%- liquid
              assign addon_ids = ''
              assign addon_products = ''
              assign addon_price = 0
              assign addon_was = 0
              assign addons_ok = true
              assign has_options = false
              for p in block.settings.products
                assign av = p.selected_or_first_available_variant
                unless p.has_only_default_variant
                  assign has_options = true
                endunless
                unless av.available
                  assign addons_ok = false
                endunless
                assign addon_ids = addon_ids | append: av.id | append: ','
                assign addon_products = addon_products | append: p.id | append: ','
                assign addon_price = addon_price | plus: av.price
                assign av_was = av.compare_at_price | default: 0 | at_least: av.price
                assign addon_was = addon_was | plus: av_was
              endfor
              assign regular = base_price | plus: addon_price
              assign keep = 100 | minus: block.settings.discount
              assign set_price = regular | times: keep | divided_by: 100.0 | round
              assign set_was = base_was | plus: addon_was
              assign save = set_was | minus: set_price
              assign save_money = save | money_without_trailing_zeros | strip_html | strip
              assign tag = block.settings.tag | default: 'SAVE [amount]' | replace: '[amount]', save_money
              assign installment = set_price | divided_by: 4.0 | round
              assign checked = false
              if first_set_done == false and addons_ok
                assign checked = true
                assign first_set_done = true
                assign cta_price = set_price
                assign cta_pct = block.settings.discount
              endif
              if block.settings.discount > 0
                assign note = section.settings.set_note_on | replace: '[percent]', block.settings.discount
              elsif max_pct > 0
                assign note = section.settings.set_note_off | replace: '[percent]', max_pct
              else
                assign note = ''
              endif
            -%}
            <label class="btf-set" {{ block.shopify_attributes }}>
              <input type="radio" name="btf-set" value="{{ block.id }}" {% if checked %}checked{% endif %} {% unless addons_ok %}disabled{% endunless %}
                data-addons="{{ addon_ids }}" data-addon-products="{{ addon_products }}" data-price="{{ set_price | money | strip_html | strip }}" data-installment="{{ installment | money | strip_html | strip }}" data-note="{{ note | escape }}" {% if has_options and section.settings.addon_auto_open %}data-auto-open{% endif %}>
              <span class="btf-set__dot"></span>
              <span class="btf-set__text">
                <span class="btf-set__name">{{ block.settings.title | escape }}
                  {%- if save > 0 -%}<small class="btf-save">{{ tag | escape }}</small>{%- endif -%}
                </span>
                <span class="text-xs btf-muted">{{ block.settings.description | replace: '[finish]', finish_name | replace: '[percent]', block.settings.discount | escape }}
                  {%- if block.settings.products.size > 0 and section.settings.addon_link != blank %} · <button type="button" class="btf-link" data-addon-open="{{ block.id }}">{{ section.settings.addon_link | escape }}</button>{%- endif -%}
                </span>
              </span>
              <span class="btf-set__price">
                <span>{{ set_price | money }}</span>
                {%- if set_was > set_price -%}<s>{{ set_was | money }}</s>{%- endif -%}
              </span>
            </label>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign cta_price = cta_price | default: base_price -%}
      {%- if sets != blank -%}
        <div class="btf-step">
          <div class="btf-step__label"><span>{{ section.settings.set_heading | escape }}</span></div>
          <div class="btf-sets">{{ sets }}</div>
          {%- if cta_pct > 0 -%}{%- assign note = section.settings.set_note_on | replace: '[percent]', cta_pct -%}{%- elsif max_pct > 0 -%}{%- assign note = section.settings.set_note_off | replace: '[percent]', max_pct -%}{%- else -%}{%- assign note = '' -%}{%- endif -%}
          {%- comment -%} No note while every set is at 0% off. {%- endcomment -%}
          <div class="text-xs btf-muted" data-set-note {% if note == blank %}hidden{% endif %}>{{ note | escape }}</div>
        </div>
      {%- endif -%}

      {%- comment -%} The button can be hidden when an offer widget brings its own Add to cart; the form stays for apps (Globo) and theme blocks. {%- endcomment -%}
      <buy-buttons class="btf-cta" form="{{ product_form_id }}" {% unless section.settings.show_cta %}hidden{% endunless %}>
        <button type="submit" name="add" class="button button--xl" data-cta {% unless variant.available %}disabled{% endunless %}>
          {%- if variant.available -%}
            <div>{{ section.settings.cta_label | escape }} · <span data-cta-price>{{ cta_price | money }}</span></div>
          {%- else -%}
            <div>{{ 'product.general.sold_out_button' | t }}</div>
          {%- endif -%}
        </button>
        <p class="btf-error" data-error role="alert" hidden></p>
      </buy-buttons>
    {%- endform -%}
    </div>

    {%- if section.settings.show_installments -%}
      {%- comment -%} Shopify's own Shop Pay Installments banner, as on the live product page (separate form, like the theme's payment terms block). {%- endcomment -%}
      <payment-terms class="product-info__payment-terms btf-payment-terms">
        {%- form 'product', product, id: 'btf-installments-form' -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          {{- form | payment_terms -}}
        {%- endform -%}
      </payment-terms>
    {%- endif -%}

    {%- if section.settings.show_stock and variant.available -%}
      {%- liquid
        assign stock = ''
        if variant.inventory_management == blank
          assign stock = section.settings.stock_text_untracked
        elsif variant.inventory_quantity > 0
          assign stock = section.settings.stock_text | replace: '[count]', variant.inventory_quantity
        endif
      -%}
      {%- if stock != blank -%}<p class="btf-stock text-sm"><span class="btf-stock__dot"></span>{{ stock | escape }}</p>{%- endif -%}
    {%- endif -%}
    {%- if theme_pos == 'after_cta' -%}{{ theme_blocks }}{%- endif -%}

    {%- comment -%} One popup per set: its accessories with photo, price and option pickers. Choices apply to every set with the same accessory. {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'set' and block.settings.products.size > 0 -%}
        <dialog class="btf-dialog" id="btf-addons-{{ block.id }}" aria-labelledby="btf-addons-title-{{ block.id }}">
          <div class="btf-dialog__head">
            <strong id="btf-addons-title-{{ block.id }}">{{ block.settings.title | escape }}</strong>
            <form method="dialog"><button class="btf-dialog__close" aria-label="{{ 'general.accessibility.close' | t | escape }}">&times;</button></form>
          </div>
          {%- comment -%} The trike in the chosen finish comes first, so the popup reads as the whole set, not just the add-ons. {%- endcomment -%}
          {%- assign base_img = variant.featured_image | default: product.featured_media.preview_image -%}
          <div class="btf-addon btf-addon--base">
            <div class="btf-addon__img">{%- if base_img -%}{%- render 'btf-image', image: base_img, widths: '192,288', sizes: '96px', alt: product.title -%}{%- endif -%}</div>
            <div class="btf-addon__info">
              <span class="bold text-sm">{{ product.title | escape }}</span>
              <span class="text-sm btf-muted">{{ variant.price | money }}</span>
              {%- if section.settings.addon_included != blank -%}<span class="text-xs btf-addon__included">{{ section.settings.addon_included | escape }}</span>{%- endif -%}
            </div>
          </div>
          {%- for p in block.settings.products -%}
            {%- assign av = p.selected_or_first_available_variant -%}
            {%- assign pimg = av.featured_image | default: p.featured_media.preview_image -%}
            <div class="btf-addon" data-product="{{ p.id }}">
              <div class="btf-addon__img">{%- if pimg -%}{%- render 'btf-image', image: pimg, widths: '192,288', sizes: '96px', alt: p.title -%}{%- endif -%}</div>
              <div class="btf-addon__info">
                <a class="bold text-sm" href="{{ p.url }}" target="_blank">{{ p.title | escape }}</a>
                <span class="text-sm btf-muted">{{ av.price | money }}</span>
                {%- unless p.has_only_default_variant -%}
                  <div class="btf-addon__options">
                    {%- for option in p.options_with_values -%}
                      <label class="text-xs">{{ option.name | escape }}
                        <select data-option="{{ forloop.index0 }}">
                          {%- for value in option.values -%}<option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value | escape }}</option>{%- endfor -%}
                        </select>
                      </label>
                    {%- endfor -%}
                  </div>
                  <span class="text-xs btf-error" data-addon-error hidden>{{ 'product.general.sold_out_button' | t }}</span>
                  <script type="application/json" data-variants>[
                    {%- for v in p.variants -%}
                      {"id":{{ v.id }},"o":{{ v.options | json }},"a":{{ v.available | json }},"img":{% if v.featured_image %}{{ v.featured_image | image_url: width: 288 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  ]</script>
                {%- endunless -%}
              </div>
            </div>
          {%- endfor -%}
          <form method="dialog"><button class="button button--sm" style="width: 100%">{{ section.settings.addon_done | escape }}</button></form>
        </dialog>
      {%- endif -%}
    {%- endfor -%}

    {%- capture trust -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust' -%}
          <div {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong><span class="btf-muted">{{ block.settings.text | escape }}</span></div>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if trust != blank -%}<div class="btf-trust">{{ trust }}</div>{%- endif -%}
    {%- if theme_pos == 'bottom' -%}{{ theme_blocks }}{%- endif -%}
  </btf-buy-box>
</div>

{% schema %}
{
  "name": "BT: buy box",
