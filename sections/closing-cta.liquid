{% comment %}
  Bentley Trike – Closing call to action with countdown.
  Joins the sticky hero's right column when placed after it.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign show_cd = false
  if s.show_countdown and s.offer_end != blank
    assign show_cd = true
  endif
-%}

<div data-bt-col>
  <section
    class="bt-cc"
    style="--bt-cc-bg: {{ s.c_bg }}; --bt-cc-text: {{ s.c_text }}; --bt-cc-label: {{ s.c_label }}; --bt-cc-btn-bg: {{ s.c_btn_bg }}; --bt-cc-btn-text: {{ s.c_btn_text }}; --bt-cc-minh: {{ s.min_height }}px;"
  >
    {%- if show_cd -%}
      <p class="bt-cc__label">{{ s.countdown_prefix }} <bt-countdown data-end="{{ s.offer_end | escape }}" data-format="short"></bt-countdown></p>
    {%- elsif s.label != blank -%}
      <p class="bt-cc__label">{{ s.label }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h2 class="bt-cc__h">{{ s.heading | replace: ' | ', '<br>' | replace: '|', '<br>' }}</h2>
    {%- endif -%}
    {%- if s.text != blank -%}
      <p class="bt-cc__p">{{ s.text }}</p>
    {%- endif -%}
    {%- if s.button_label != blank -%}
      <a class="bt-cc__btn" href="{{ s.button_link | default: '#bt-claim' }}">{{ s.button_label }}</a>
    {%- endif -%}
  </section>
</div>

{% style %}
  .bt-cc {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    min-height: var(--bt-cc-minh, 420px);
    padding: 72px clamp(20px, 4vw, 72px);
    background: var(--bt-cc-bg);
    color: var(--bt-cc-text);
    text-align: center;
  }
  .bt-cc__label {
    margin: 0;
    color: var(--bt-cc-label);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .bt-cc__h {
    max-width: 620px;
    margin: 0;
    color: var(--bt-cc-text);
    font-family: var(--heading-font-family, var(--font-heading-family, Georgia, serif));
    font-size: clamp(30px, 3vw, 46px);
    font-weight: 400;
    line-height: 1.08;
  }
  .bt-cc__p {
    max-width: 480px;
    margin: 0;
    color: var(--bt-cc-label);
    font-size: 15px;
    line-height: 1.6;
  }
  .bt-cc__btn {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    min-height: 56px;
    padding: 0 36px;
    background: var(--bt-cc-btn-bg);
    color: var(--bt-cc-btn-text);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: filter 0.15s ease-in-out;
  }
  .bt-cc__btn:hover {
    filter: brightness(0.88);
    color: var(--bt-cc-btn-text);
  }
  @media (max-width: 749px) {
    .bt-cc {
      min-height: 0;
      padding: 56px 16px;
    }
    .bt-cc__btn {
      width: 100%;
    }
  }
{% endstyle %}

<script>
  (function () {
    if (customElements.get('bt-countdown')) return;
    function pad(n) {
      return (n < 10 ? '0' : '') + n;
    }
    customElements.define(
      'bt-countdown',
      class extends HTMLElement {
        connectedCallback() {
          var m = String(this.dataset.end || '')
            .trim()
            .match(/^(\d{4})-(\d{1,2})-(\d{1,2})(?:[ T](\d{1,2}):(\d{2}))?/);
          if (!m) {
            this.hidden = true;
            return;
          }
          this.end = new Date(+m[1], +m[2] - 1, +m[3], m[4] ? +m[4] : 23, m[5] ? +m[5] : 59, 59);
          var self = this;
          this.tick();
          // children may not be parsed yet when this runs early – tick again once they are
          setTimeout(function () {
            self.tick();
          }, 0);
          if (document.readyState === 'loading')
            document.addEventListener('DOMContentLoaded', function () {
              self.tick();
            });
          this.timer = setInterval(this.tick.bind(this), this.dataset.format === 'boxes' ? 1000 : 30000);
        }
        disconnectedCallback() {
          clearInterval(this.timer);
        }
        tick() {
          var left = Math.max(0, Math.floor((this.end - new Date()) / 1000));
          var d = Math.floor(left / 86400);
          var h = Math.floor((left % 86400) / 3600);
          var mi = Math.floor((left % 3600) / 60);
          var se = left % 60;
          if (this.dataset.format === 'boxes') {
            var set = function (el, k, v) {
              var t = el.querySelector('[data-' + k + ']');
              if (t) t.textContent = pad(v);
            };
            set(this, 'd', d);
            set(this, 'h', h);
            set(this, 'm', mi);
            set(this, 's', se);
          } else {
            this.textContent = d + 'd ' + h + 'h ' + mi + 'm';
          }
        }
      }
    );
  })();
</script>

{% schema %}
{
  "name": "BT Closing CTA",
  "tag": "section",
  "class": "bt-cta-section",
  "settings": [
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": true },
    { "type": "text", "id": "countdown_prefix", "label": "Countdown text", "default": "This page closes in" },
    { "type": "text", "id": "offer_end", "label": "Offer ends", "default": "2026-11-30 23:59", "info": "YYYY-MM-DD HH:MM in the shopper’s local time" },
    { "type": "text", "id": "label", "label": "Small label (if no countdown)", "default": "Private offer" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Type | where you want a new line.", "default": "Some deals are shared. | This one is <em>Whispered</em>." },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Claim my free car" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to jump to the bundle builder" },
    { "type": "range", "id": "min_height", "label": "Minimum height (desktop)", "min": 200, "max": 800, "step": 20, "unit": "px", "default": 420 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#00221c" },
    { "type": "color", "id": "c_text", "label": "Heading", "default": "#ffffff" },
    { "type": "color", "id": "c_label", "label": "Small text", "default": "#d9d0c5" },
    { "type": "color", "id": "c_btn_bg", "label": "Button background", "default": "#a83f2f" },
    { "type": "color", "id": "c_btn_text", "label": "Button text", "default": "#ffffff" }
  ],
  "presets": [{ "name": "BT Closing CTA" }]
}
{% endschema %}