    { "type": "checkbox", "id": "text_mobile", "label": "Show description", "default": true, "info": "Turn off to keep shorter phone slides uncluttered." },
    { "type": "header", "content": "Heading size" },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (phone)", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent (sand)", "default": "#d9d0c5" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#ffffff" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#1a1a1a" },
    { "type": "color", "id": "intro_bg", "label": "Reveal background", "default": "#1a1a1a" },
    { "type": "color", "id": "intro_text", "label": "Reveal wordmark", "default": "#f8f4ef" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (desktop)", "info": "Landscape, at least 2400px wide. Set a focal point in the image settings." },
        { "type": "image_picker", "id": "image_mobile", "label": "Image (phone)", "info": "Portrait works best. Leave empty to use the desktop image." },
        { "type": "video", "id": "video", "label": "Video (desktop, optional)", "info": "Plays muted on a loop instead of the image, only while this slide shows." },
        { "type": "video", "id": "video_mobile", "label": "Video (phone, optional)" },
        { "type": "text", "id": "heading_1", "label": "Heading line 1", "default": "Extraordinary journeys" },
        { "type": "text", "id": "heading_2", "label": "Heading line 2 (italic)", "default": "start young." },
        { "type": "textarea", "id": "subheading", "label": "Text under heading", "info": "Optional. Sits between the heading and the details row." },
        { "type": "text", "id": "meta_1", "label": "Small detail 1", "default": "The Bentley 6-in-1 Stroller Trike" },
        { "type": "text", "id": "meta_2", "label": "Small detail 2", "default": "Officially licensed by Bentley Motors" },
        { "type": "text", "id": "meta_3", "label": "Small detail 3", "default": "From 6 months" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "A stroller you steer today, a trike that's entirely theirs tomorrow — finished in the colours of the cars from Crewe." },
        { "type": "text", "id": "button_1_label", "label": "Button 1 label", "default": "Shop the Trike" },
        { "type": "url", "id": "button_1_link", "label": "Button 1 link", "info": "Leave empty to scroll to the Trike buy box." },
        { "type": "text", "id": "button_2_label", "label": "Button 2 label", "default": "See how it grows" },
        { "type": "url", "id": "button_2_link", "label": "Button 2 link", "info": "Leave empty to scroll to the growth stages." },
        { "type": "header", "content": "Text on this slide only" },
        { "type": "select", "id": "al_desktop", "label": "Left / right (desktop)", "options": [{ "value": "default", "label": "Same as section" }, { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" }], "default": "default" },
        { "type": "select", "id": "v_desktop", "label": "Up / down (desktop)", "options": [{ "value": "default", "label": "Same as section" }, { "value": "top", "label": "Top" }, { "value": "middle", "label": "Middle" }, { "value": "bottom", "label": "Bottom" }, { "value": "split", "label": "Split: heading top, buttons bottom" }], "default": "default" },
        { "type": "select", "id": "v_mobile", "label": "Up / down (phone)", "options": [{ "value": "default", "label": "Same as section" }, { "value": "top", "label": "Top" }, { "value": "middle", "label": "Middle" }, { "value": "bottom", "label": "Bottom" }, { "value": "split", "label": "Split: heading top, buttons bottom" }], "default": "default" },
        { "type": "select", "id": "al_mobile", "label": "Left / right (phone)", "options": [{ "value": "default", "label": "Same as section" }, { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" }], "default": "default" },
        { "type": "range", "id": "side_dark", "label": "Darken behind text", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0, "info": "Darkens only the side where the text sits, so bright photos stay bright. Try 35 to 50% on light walls." }
      ]
    }
  ],
  "presets": [
    {
      "name": "BT Hero slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide", "settings": { "heading_1": "Hand-finished,", "heading_2": "the Mulliner way.", "meta_1": "Mulliner editions", "meta_2": "Quilted leather-look seat", "meta_3": "Limited colours", "text": "Diamond quilting, hand-painted coachlines and colours drawn from Bentley's Mulliner studio.", "button_1_label": "Shop Mulliner", "button_2_label": "" } },
        { "type": "slide", "settings": { "heading_1": "Folds in one move,", "heading_2": "goes everywhere.", "meta_1": "The Folding Trike", "meta_2": "Travel-ready", "meta_3": "From 10 months", "text": "Collapses flat with one hand, small enough for the boot or an overhead locker.", "button_1_label": "Shop Folding", "button_2_label": "" } }
      ]
    }
  ]
}
